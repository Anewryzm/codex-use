print_login_status_for_home() {
  local target_home="$1"
  local login_status
  login_status="$(CODEX_HOME="$target_home" "$CODEX_BIN" login status 2>&1 || true)"
  login_status="$(printf '%s\n' "$login_status" | sed '/^WARNING: proceeding, even though we could not update PATH:/d')"
  if [ -n "$(printf '%s' "$login_status" | tr -d '[:space:]')" ]; then
    printf '%s\n' "$login_status"
  fi
}

fetch_usage_via_rpc() {
  local target_home="$1"
  local json_mode="$2"
  local refresh_mode="$3"

  CODEX_HOME="$target_home" node - "$CODEX_BIN" "$json_mode" "$refresh_mode" <<'NODE'
const { spawn } = require('child_process');

const codexBin = process.argv[2] || 'codex';
const jsonMode = process.argv[3] === 'true';
const refreshMode = process.argv[4] === 'true';

const child = spawn(codexBin, ['app-server'], { stdio: ['pipe', 'pipe', 'pipe'] });
let buf = '';
let settled = false;
let seq = 1;
const pending = new Map();

function done(code) {
  if (settled) return;
  settled = true;
  try { child.kill('SIGTERM'); } catch {}
  setTimeout(() => process.exit(code), 80);
}

function send(method, params) {
  const id = seq++;
  const msg = { jsonrpc: '2.0', id, method };
  if (params !== undefined) msg.params = params;
  child.stdin.write(JSON.stringify(msg) + '\n');
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => {
      pending.delete(id);
      reject(new Error(`timeout for ${method}`));
    }, 12000);
    pending.set(id, { resolve, reject, t });
  });
}

child.stderr.on('data', (d) => {
  const s = d.toString('utf8').trim();
  if (!s) return;
  if (/ERROR|failed to fetch codex rate limits|not logged in/i.test(s)) {
    process.stderr.write(s + '\n');
  }
});

child.stdout.on('data', (chunk) => {
  buf += chunk.toString('utf8');
  let idx;
  while ((idx = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, idx).trim();
    buf = buf.slice(idx + 1);
    if (!line) continue;

    let msg;
    try {
      msg = JSON.parse(line);
    } catch {
      continue;
    }

    if (msg.id != null && pending.has(msg.id)) {
      const p = pending.get(msg.id);
      clearTimeout(p.t);
      pending.delete(msg.id);
      if (msg.error) p.reject(new Error(msg.error?.message || JSON.stringify(msg.error)));
      else p.resolve(msg.result);
    }
  }
});

child.on('error', (err) => {
  console.error(`RPC spawn error: ${err.message}`);
  done(1);
});

function windowLabel(minutes) {
  if (minutes === 300) return '5h';
  if (minutes === 10080) return 'weekly';
  if (typeof minutes === 'number') return `${minutes}m`;
  return 'window';
}

function resetText(epochSeconds) {
  if (epochSeconds == null) return 'unknown';
  const nowMs = Date.now();
  const targetMs = epochSeconds * 1000;
  const deltaMs = targetMs - nowMs;
  const absMs = Math.abs(deltaMs);
  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(' ');
  return deltaMs >= 0 ? `in ${relative}` : `${relative} ago`;
}

(async () => {
  try {
    const init = await send('initialize', {
      clientInfo: { name: 'codexacct', version: '0.2.0' },
    });

    const accountResp = await send('account/read', { forceRefresh: refreshMode });
    const limitsResp = await send('account/rateLimits/read');

    const account = accountResp?.account || null;
    const snapshot = (limitsResp?.rateLimitsByLimitId && (limitsResp.rateLimitsByLimitId.codex || Object.values(limitsResp.rateLimitsByLimitId)[0]))
      || limitsResp?.rateLimits
      || null;

    if (!snapshot) {
      throw new Error('No rate limit snapshot returned by app-server');
    }

    const out = {
      codexHome: init?.codexHome || null,
      account,
      requiresOpenaiAuth: !!accountResp?.requiresOpenaiAuth,
      rateLimits: snapshot,
      rateLimitsByLimitId: limitsResp?.rateLimitsByLimitId || null,
    };

    if (jsonMode) {
      console.log(JSON.stringify(out, null, 2));
      done(0);
      return;
    }

    const email = account?.email || 'unknown';
    const plan = account?.planType || snapshot?.planType || 'unknown';
    const primary = snapshot?.primary || null;
    const secondary = snapshot?.secondary || null;
    const credits = snapshot?.credits || null;

    console.log(`email: ${email}`);
    console.log(`plan: ${plan}`);

    if (primary) {
      const used = Number(primary.usedPercent ?? 0);
      const rem = Math.max(0, 100 - used);
      console.log(`${windowLabel(primary.windowDurationMins)} used: ${used}%`);
      console.log(`${windowLabel(primary.windowDurationMins)} remaining: ${rem}%`);
      console.log(`${windowLabel(primary.windowDurationMins)} resets_in: ${resetText(primary.resetsAt)}`);
    } else {
      console.log('primary window: unavailable');
    }

    if (secondary) {
      const used = Number(secondary.usedPercent ?? 0);
      const rem = Math.max(0, 100 - used);
      console.log(`${windowLabel(secondary.windowDurationMins)} used: ${used}%`);
      console.log(`${windowLabel(secondary.windowDurationMins)} remaining: ${rem}%`);
      console.log(`${windowLabel(secondary.windowDurationMins)} resets_in: ${resetText(secondary.resetsAt)}`);
    } else {
      console.log('secondary window: unavailable');
    }

    if (credits) {
      console.log(`credits.hasCredits: ${credits.hasCredits}`);
      console.log(`credits.unlimited: ${credits.unlimited}`);
      console.log(`credits.balance: ${credits.balance == null ? 'null' : credits.balance}`);
    } else {
      console.log('credits: unavailable');
    }

    done(0);
  } catch (err) {
    console.error(`RPC usage probe failed: ${err.message}`);
    done(1);
  }
})();
NODE
}

collect_usage_targets() {
  echo "default|$DEFAULT_HOME"
  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    local name
    name="$(basename "$d")"
    echo "$name|$d"
  done
}

json_usage_to_tsv() {
  node -e '
const fs = require("fs");
const raw = fs.readFileSync(0, "utf8");
const data = JSON.parse(raw);
const r = data?.rateLimits || {};
const p = r?.primary || null;
const s = r?.secondary || null;
const email = data?.account?.email || "unknown";
const plan = data?.account?.planType || r?.planType || "unknown";

function rem(value) {
  return (typeof value === "number") ? `${Math.max(0, 100 - value)}%` : "-";
}

function reset(epochSeconds) {
  if (epochSeconds == null) return "-";
  const nowMs = Date.now();
  const targetMs = epochSeconds * 1000;
  const deltaMs = targetMs - nowMs;
  const absMs = Math.abs(deltaMs);
  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(" ");
  return deltaMs >= 0 ? `in ${relative}` : `${relative} ago`;
}

const row = [
  email,
  plan,
  rem(p?.usedPercent),
  reset(p?.resetsAt),
  rem(s?.usedPercent),
  reset(s?.resetsAt),
];

process.stdout.write(row.join("\t"));
'
}

json_usage_details_to_tsv() {
  node -e '
const fs = require("fs");
const raw = fs.readFileSync(0, "utf8");
const data = JSON.parse(raw);
const r = data?.rateLimits || {};
const p = r?.primary || null;
const s = r?.secondary || null;
const credits = r?.credits || null;

function label(minutes, fallback) {
  if (minutes === 300) return "5h";
  if (minutes === 10080) return "weekly";
  if (typeof minutes === "number") return `${minutes}m`;
  return fallback;
}

function used(value) {
  return (typeof value === "number") ? `${Math.max(0, Math.min(100, value))}%` : "-";
}

function remaining(value) {
  return (typeof value === "number") ? `${Math.max(0, 100 - value)}%` : "-";
}

function resetRelative(epochSeconds) {
  if (epochSeconds == null) return "unknown";
  const nowMs = Date.now();
  const targetMs = epochSeconds * 1000;
  const deltaMs = targetMs - nowMs;
  const absMs = Math.abs(deltaMs);
  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(" ");
  return deltaMs >= 0 ? `in ${relative}` : `${relative} ago`;
}

const pRel = resetRelative(p?.resetsAt);
const sRel = resetRelative(s?.resetsAt);

const row = [
  label(p?.windowDurationMins, "primary"),
  remaining(p?.usedPercent),
  pRel,
  label(s?.windowDurationMins, "secondary"),
  remaining(s?.usedPercent),
  sRel,
  credits ? String(credits.hasCredits) : "-",
  credits ? String(credits.unlimited) : "-",
  credits && credits.balance != null ? String(credits.balance) : "null",
];

process.stdout.write(row.join("\t"));
'
}

print_usage_details_for_home() {
  local target_home="$1"
  local refresh_mode="${2:-false}"

  local rpc_json err_file
  err_file="$(mktemp)"
  if rpc_json="$(fetch_usage_via_rpc "$target_home" "true" "$refresh_mode" 2>"$err_file")"; then
    local tsv
    if tsv="$(printf "%s" "$rpc_json" | json_usage_details_to_tsv 2>/dev/null)"; then
      local p_label p_left p_rel s_label s_left s_rel c_has c_unlimited c_balance
      IFS=$'\t' read -r p_label p_left p_rel s_label s_left s_rel c_has c_unlimited c_balance <<<"$tsv"
      local p_bar s_bar p_hint s_hint credits_line
      p_bar="$(render_percent_bar "$p_left")"
      s_bar="$(render_percent_bar "$s_left")"
      p_hint="$(renewal_hint_text "$p_rel")"
      s_hint="$(renewal_hint_text "$s_rel")"
      credits_line="$(format_credits_line "$c_has" "$c_unlimited" "$c_balance")"

      echo "--- usage & limits ---"
      echo
      echo "$p_label remaining: $(color_cyan "$p_left") $(color_cyan "$p_bar") ($(color_gray "$p_hint"))"
      echo "$s_label remaining: $(color_cyan "$s_left") $(color_cyan "$s_bar") ($(color_gray "$s_hint"))"
      echo "$credits_line"
    else
      echo "--- usage & limits ---"
      echo
      echo "usage unavailable: parse-error"
    fi
  else
    local rpc_err err_lc reason
    rpc_err="$(cat "$err_file")"
    rpc_err="$(echo "$rpc_err" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    err_lc="$(printf "%s" "$rpc_err" | tr '[:upper:]' '[:lower:]')"
    if [[ "$err_lc" == *"not logged in"* ]] || [[ "$err_lc" == *"requiresopenaiauth"* ]]; then
      reason="not-logged"
    elif [[ "$err_lc" == *"no rate limit snapshot"* ]]; then
      reason="no-limits"
    elif [[ "$err_lc" == *"timeout"* ]]; then
      reason="timeout"
    else
      reason="rpc-error"
    fi

    echo "--- usage & limits ---"
    echo
    echo "usage unavailable: $reason"
  fi
  rm -f "$err_file"
}

crop_cell() {
  local text="$1"
  local width="$2"
  if [ "${#text}" -le "$width" ]; then
    printf "%s" "$text"
    return 0
  fi
  if [ "$width" -le 3 ]; then
    printf "%s" "${text:0:$width}"
    return 0
  fi
  printf "%s..." "${text:0:$((width-3))}"
}

print_usage_table_header() {
  printf '+------------+---------------------------------+------------------+-----------------+\n'
  printf '| %-10s | %-31s | %-16s | %-15s |\n' \
    "profile" "email" "5h (reset)" "weekly (reset)"
  printf '+------------+---------------------------------+------------------+-----------------+\n'
}

print_usage_table_row() {
  local profile="$1"
  local email="$2"
  local five_h="$3"
  local weekly="$4"
  local ok_flag="${5:-false}"
  local check_char="-"
  if [ "$ok_flag" = "true" ]; then
    check_char="$(color_green "✓")"
  fi

  printf '| %-10s | %s %-29s | %-16s | %-15s |\n' \
    "$(crop_cell "$profile" 10)" \
    "$check_char" \
    "$(crop_cell "$email" 29)" \
    "$(crop_cell "$five_h" 16)" \
    "$(crop_cell "$weekly" 15)"
}

print_usage_table_footer() {
  printf '+------------+---------------------------------+------------------+-----------------+\n'
}

print_current_default_profile_line() {
  local active_profile_for_default="$1"
  if [ -n "$active_profile_for_default" ]; then
    echo "Current default profile: $(color_green_bold "${active_profile_for_default}*")"
  else
    echo "Current default profile: $(color_gray "unknown")"
  fi
}

print_usage_table_row_for_home() {
  local label="$1"
  local target_home="$2"
  local refresh_mode="$3"
  local mark_active="${4:-false}"

  local display_label="$label"
  if [ "$mark_active" = "true" ]; then
    display_label="${display_label}*"
  fi

  local target_auth
  target_auth="$(auth_file "$target_home")"
  if [ ! -f "$target_auth" ]; then
    print_usage_table_row "$display_label" "no-auth" "-" "-" "false"
    return 0
  fi

  local rpc_json rpc_err tsv err_file
  err_file="$(mktemp)"
  if rpc_json="$(fetch_usage_via_rpc "$target_home" "true" "$refresh_mode" 2>"$err_file")"; then
    if tsv="$(printf "%s" "$rpc_json" | json_usage_to_tsv 2>/dev/null)"; then
      local email plan p_left p_reset s_left s_reset five_h_cell weekly_cell
      IFS=$'\t' read -r email plan p_left p_reset s_left s_reset <<<"$tsv"
      five_h_cell="$(compact_window_cell "$p_left" "$p_reset")"
      weekly_cell="$(compact_window_cell "$s_left" "$s_reset")"
      print_usage_table_row "$display_label" "$email" "$five_h_cell" "$weekly_cell" "true"
    else
      print_usage_table_row "$display_label" "parse-error" "-" "-" "false"
    fi
  else
    rpc_err="$(cat "$err_file")"
    rpc_err="$(echo "$rpc_err" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    local err_lc status
    err_lc="$(printf "%s" "$rpc_err" | tr '[:upper:]' '[:lower:]')"
    if [[ "$err_lc" == *"not logged in"* ]] || [[ "$err_lc" == *"requiresopenaiauth"* ]]; then
      status="not-logged"
    elif [[ "$err_lc" == *"no rate limit snapshot"* ]]; then
      status="no-limits"
    elif [[ "$err_lc" == *"timeout"* ]]; then
      status="timeout"
    else
      status="rpc-error"
    fi
    print_usage_table_row "$display_label" "$status" "-" "-" "false"
  fi
  rm -f "$err_file"
}

cmd_login() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: codexacct login <profile> [extra login flags]"
  validate_profile "$profile"
  ensure_dirs

  local p_home
  p_home="$(profile_home "$profile")"
  mkdir -p "$p_home"

  echo "Logging in profile '$profile' at: $p_home"
  CODEX_HOME="$p_home" "$CODEX_BIN" login "$@"

  echo "Profile '$profile' login complete."
  echo "--- auth summary ($profile) ---"
  print_auth_summary "$(auth_file "$p_home")"
}

cmd_use() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: codexacct use <profile> [--force] [--relaunch]"
  validate_profile "$profile"
  ensure_dirs

  local force="false"
  local relaunch="false"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force)
        force="true"
        ;;
      --relaunch|--restart-app)
        relaunch="true"
        ;;
      *)
        die "Unknown option '$1'. Usage: codexacct use <profile> [--force] [--relaunch]"
        ;;
    esac
    shift
  done

  local p_home src dst
  p_home="$(profile_home "$profile")"
  src="$(auth_file "$p_home")"
  dst="$(auth_file "$DEFAULT_HOME")"

  [ -f "$src" ] || die "Profile '$profile' has no auth.json. Run: codexacct login $profile"

  if is_codex_app_running; then
    if [ "$relaunch" = "true" ]; then
      echo "Codex App is running. Closing it before switch..."
      if ! quit_codex_app; then
        die "Could not close Codex App cleanly. Close it manually and retry."
      fi
    elif [ "$force" != "true" ]; then
      die "Codex App is running. Close it first, or use 'codexacct use $profile --relaunch' (recommended) or '--force' if you accept in-flight risk."
    fi
  fi

  local backup_notice=""
  if [ -f "$dst" ]; then
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    local backup_path
    backup_path="$BACKUP_DIR/auth.$ts.json"
    cp "$dst" "$backup_path"
    chmod 600 "$backup_path" || true
    backup_notice="Backup created: $backup_path"
  fi

  cp "$src" "$dst"
  chmod 600 "$dst" || true

  echo "$(color_green "Default profile switched to '")$(color_green_bold "$profile")$(color_green "'.")"
  if [ -n "$backup_notice" ]; then
    echo "$backup_notice"
  fi
  echo
  echo "--- auth summary (default) ---"
  echo
  print_auth_summary_whoami "$dst"
  echo
  if [ "$relaunch" = "true" ]; then
    if open_codex_app; then
      echo "Codex App relaunched to pick up the new default auth."
    else
      echo "Switched auth, but failed to relaunch Codex App automatically. Open it manually."
    fi
  else
    echo "Tip: open/restart Codex App to ensure UI/session state reflects the new default account."
  fi
}

cmd_usage() {
  local command_mode="${1:-usage}"
  if [ "$command_mode" = "usage" ] || [ "$command_mode" = "limits" ]; then
    shift || true
  else
    command_mode="usage"
  fi

  ensure_dirs

  local profile="default"
  local json_mode="false"
  local refresh_mode="false"
  local all_mode="false"
  local profile_set="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        all_mode="true"
        ;;
      -a)
        all_mode="true"
        ;;
      --json)
        json_mode="true"
        ;;
      --refresh)
        refresh_mode="true"
        ;;
      default)
        profile="default"
        profile_set="true"
        ;;
      -h|--help)
        echo "Usage: codexacct $command_mode [profile|default] [--all] [--json] [--refresh]"
        echo "Examples:"
        echo "  codexacct $command_mode"
        echo "  codexacct $command_mode trabajo"
        echo "  codexacct $command_mode default --json"
        echo "  codexacct $command_mode --all"
        echo "  codexacct $command_mode -a"
        return 0
        ;;
      *)
        if [[ "$1" == --* ]]; then
          die "Unknown option '$1'"
        fi
        if [ "$profile_set" = "true" ]; then
          die "Only one profile argument is allowed."
        fi
        profile="$1"
        profile_set="true"
        ;;
    esac
    shift
  done

  if [ "$all_mode" = "true" ]; then
    [ "$json_mode" != "true" ] || die "--all does not support --json yet."
    [ "$profile_set" != "true" ] || die "Do not pass profile/default with --all."

    local active_profile_for_default
    active_profile_for_default="$(normalized_active_profile)"
    print_current_default_profile_line "$active_profile_for_default"
    echo

    print_usage_table_header
    while IFS='|' read -r label target_home; do
      [ -n "$label" ] || continue
      if [ "$label" = "default" ]; then
        continue
      fi
      local mark_active="false"
      if [ -n "$active_profile_for_default" ] && [ "$label" = "$active_profile_for_default" ]; then
        mark_active="true"
      fi
      print_usage_table_row_for_home "$label" "$target_home" "$refresh_mode" "$mark_active"
    done < <(collect_usage_targets)
    print_usage_table_footer
    return 0
  fi

  local target_home label
  if [ "$profile" = "default" ]; then
    target_home="$DEFAULT_HOME"
    label="default"
  else
    validate_profile "$profile"
    target_home="$(profile_home "$profile")"
    [ -d "$target_home" ] || die "Profile '$profile' does not exist"
    label="$profile"
  fi

  [ -f "$(auth_file "$target_home")" ] || die "No auth.json found for '$label' at $target_home"

  if [ "$json_mode" != "true" ]; then
    local active_profile_for_default
    active_profile_for_default="$(normalized_active_profile)"
    print_current_default_profile_line "$active_profile_for_default"
    echo
    print_usage_table_header
    local mark_active="false"
    if [ "$label" != "default" ] && [ -n "$active_profile_for_default" ] && [ "$label" = "$active_profile_for_default" ]; then
      mark_active="true"
    fi
    print_usage_table_row_for_home "$label" "$target_home" "$refresh_mode" "$mark_active"
    print_usage_table_footer
    return 0
  fi

  fetch_usage_via_rpc "$target_home" "$json_mode" "$refresh_mode"
}

cmd_list() {
  ensure_dirs

  local default_auth default_account default_fp
  default_auth="$(auth_file "$DEFAULT_HOME")"
  default_account=""
  default_fp=""
  if [ -f "$default_auth" ]; then
    default_account="$(auth_account_id "$default_auth")"
    default_fp="$(auth_fingerprint "$default_auth")"
  fi

  echo "Default home: $(color_gray "$DEFAULT_HOME")"
  if [ -f "$default_auth" ]; then
    echo "Default account_id: ${default_account:-unknown}"
  else
    echo "Default account_id: (not logged in)"
  fi
  echo

  local found="false"
  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    found="true"
    local name a
    name="$(basename "$d")"
    a="$(auth_file "$d")"

    local acc
    if [ -f "$a" ]; then
      acc="$(auth_account_id "$a")"
      local mark=" "
      local fp
      fp="$(auth_fingerprint "$a")"
      if [ -n "$default_fp" ] && [ -n "$fp" ] && [ "$fp" = "$default_fp" ]; then
        mark="*"
      elif [ -n "$default_account" ] && [ "$acc" = "$default_account" ]; then
        mark="~"
      fi
      echo "[$mark] $name"
      print_auth_summary "$a" | sed 's/^/    /'
    else
      echo "[ ] $name"
      echo "    auth: missing"
    fi
    echo
  done

  if [ "$found" = "false" ]; then
    echo "No profiles yet. Create one with: codexacct login <profile>"
  fi

  echo "Legend: '*' means exact same auth token as current default ~/.codex/auth.json"
  echo "        '~' means same account_id but different token/identity"
}

cmd_whoami() {
  ensure_dirs
  local d_auth active_profile
  d_auth="$(auth_file "$DEFAULT_HOME")"
  active_profile="$(detect_active_profile)"
  print_login_status_for_home "$DEFAULT_HOME"
  echo "$(color_green "Active profile: ")$(color_green_bold "$active_profile")"
  echo "Default home: $(color_gray "$DEFAULT_HOME")"
  echo
  echo "--- auth summary (default) ---"
  echo
  print_auth_summary_whoami "$d_auth"
}

cmd_status() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: codexacct status <profile> [--refresh]"
  validate_profile "$profile"

  local refresh_mode="false"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --refresh)
        refresh_mode="true"
        ;;
      *)
        die "Unknown option '$1'. Usage: codexacct status <profile> [--refresh]"
        ;;
    esac
    shift
  done

  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"
  local p_auth
  p_auth="$(auth_file "$p_home")"
  [ -f "$p_auth" ] || die "No auth.json found for '$profile' at $p_home"

  print_login_status_for_home "$p_home"
  echo "$(color_green "Profile: ")$(color_green_bold "$profile")"
  echo "Profile home: $(color_gray "$p_home")"
  echo
  echo "--- auth summary ($profile) ---"
  echo
  print_auth_summary_whoami "$p_auth"
  echo
  print_usage_details_for_home "$p_home" "$refresh_mode"
}

cmd_logout() {
  local profile="${1:-}"
  [ -n "$profile" ] || die "Usage: codexacct logout <profile>"
  validate_profile "$profile"
  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"
  CODEX_HOME="$p_home" "$CODEX_BIN" logout || true
  echo "Logged out profile '$profile'"
}

cmd_logout_default() {
  "$CODEX_BIN" logout || true
  echo "Logged out default profile ($DEFAULT_HOME)"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    login) cmd_login "$@" ;;
    use) cmd_use "$@" ;;
    usage) cmd_usage usage "$@" ;;
    limits) cmd_usage limits "$@" ;;
    list) cmd_list ;;
    whoami) cmd_whoami ;;
    status) cmd_status "$@" ;;
    logout) cmd_logout "$@" ;;
    logout-default) cmd_logout_default ;;
    help|-h|--help) usage ;;
    *) die "Unknown command '$cmd'. Run: codexacct help" ;;
  esac
}

main "$@"
