#!/usr/bin/env bash
set -euo pipefail

DEFAULT_HOME="${CODEX_DEFAULT_HOME:-$HOME/.codex}"
PROFILES_ROOT="${CODEX_PROFILES_HOME:-$HOME/.codex-profiles}"
CODEX_BIN="${CODEX_BIN:-codex}"
BACKUP_DIR="$DEFAULT_HOME/backups"

usage() {
  cat <<USAGE
codexacct - Multi-account profile manager for Codex default home

Usage:
  codexacct login <profile> [--device-auth|extra codex login flags]
  codexacct use <profile> [--force]
  codexacct usage [profile|default] [--all] [--json] [--refresh]
  codexacct limits [profile|default] [--all] [--json] [--refresh]
  codexacct list
  codexacct whoami
  codexacct status <profile>
  codexacct logout <profile>
  codexacct logout-default

Core flow:
  1) Save credentials per profile:  codexacct login personal
  2) Switch active default account: codexacct use personal
  3) Check usage/rate limits:       codexacct usage default
  4) Compare all profiles:          codexacct usage --all

Notes:
  - Default Codex App + CLI home is: $DEFAULT_HOME
  - Profile homes are stored in:      $PROFILES_ROOT/<profile>
  - 'use' copies <profile>/auth.json into $DEFAULT_HOME/auth.json
  - 'usage' uses Codex app-server RPC (account/read + account/rateLimits/read)
USAGE
}

die() {
  echo "Error: $*" >&2
  exit 1
}

ensure_dirs() {
  mkdir -p "$DEFAULT_HOME" "$PROFILES_ROOT" "$BACKUP_DIR"
}

validate_profile() {
  local profile="$1"
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile name '$profile'. Use letters, numbers, dot, underscore, or dash."
}

profile_home() {
  echo "$PROFILES_ROOT/$1"
}

auth_file() {
  echo "$1/auth.json"
}

is_codex_app_running() {
  pgrep -f "/Applications/Codex.app/Contents/MacOS/Codex" >/dev/null 2>&1
}

print_auth_summary() {
  local auth_path="$1"
  [ -f "$auth_path" ] || {
    echo "auth: missing ($auth_path)"
    return 0
  }

  node - "$auth_path" <<'NODE'
const fs = require('fs');
const p = process.argv[2];
try {
  const j = JSON.parse(fs.readFileSync(p, 'utf8'));
  const accountId = j?.tokens?.account_id || 'unknown';
  let email = 'unknown';
  let plan = 'unknown';
  let org = 'unknown';
  const supportsColor = Boolean(process.stdout.isTTY) && !process.env.NO_COLOR;
  const yellow = '\x1b[33m';
  const reset = '\x1b[0m';
  const id = j?.tokens?.id_token;
  if (id && id.includes('.')) {
    const payload = JSON.parse(Buffer.from(id.split('.')[1], 'base64url').toString('utf8'));
    email = payload?.email || email;
    const auth = payload?.['https://api.openai.com/auth'] || {};
    plan = auth?.chatgpt_plan_type || plan;
    const orgs = Array.isArray(auth?.organizations) ? auth.organizations : [];
    const defOrg = orgs.find(o => o && o.is_default) || orgs[0];
    if (defOrg && defOrg.title) org = defOrg.title;
  }
  console.log(`account_id: ${accountId}`);
  if (supportsColor) {
    console.log(`email: ${yellow}${email}${reset}`);
  } else {
    console.log(`email: ${email}`);
  }
  console.log(`plan: ${plan}`);
  console.log(`default_org: ${org}`);
} catch (e) {
  console.log(`auth parse error: ${e.message}`);
}
NODE
}

fetch_usage_via_rpc() {
  local target_home="$1"
  local json_mode="$2"
  local refresh_mode="$3"

  CODEX_HOME="$target_home" node - "$CODEX_BIN" "$json_mode" "$refresh_mode" <<'NODE'
const { spawn } = require('child_process');

const codexBin = process.argv[2] || 'codex';
const jsonMode = process.argv[3] === 'true';
const refreshMode = process.argv[4] === 'true';

const child = spawn(codexBin, ['app-server'], { stdio: ['pipe', 'pipe', 'pipe'] });
let buf = '';
let settled = false;
let seq = 1;
const pending = new Map();

function done(code) {
  if (settled) return;
  settled = true;
  try { child.kill('SIGTERM'); } catch {}
  setTimeout(() => process.exit(code), 80);
}

function send(method, params) {
  const id = seq++;
  const msg = { jsonrpc: '2.0', id, method };
  if (params !== undefined) msg.params = params;
  child.stdin.write(JSON.stringify(msg) + '\n');
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => {
      pending.delete(id);
      reject(new Error(`timeout for ${method}`));
    }, 12000);
    pending.set(id, { resolve, reject, t });
  });
}

child.stderr.on('data', (d) => {
  const s = d.toString('utf8').trim();
  if (!s) return;
  if (/ERROR|failed to fetch codex rate limits|not logged in/i.test(s)) {
    process.stderr.write(s + '\n');
  }
});

child.stdout.on('data', (chunk) => {
  buf += chunk.toString('utf8');
  let idx;
  while ((idx = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, idx).trim();
    buf = buf.slice(idx + 1);
    if (!line) continue;

    let msg;
    try {
      msg = JSON.parse(line);
    } catch {
      continue;
    }

    if (msg.id != null && pending.has(msg.id)) {
      const p = pending.get(msg.id);
      clearTimeout(p.t);
      pending.delete(msg.id);
      if (msg.error) p.reject(new Error(msg.error?.message || JSON.stringify(msg.error)));
      else p.resolve(msg.result);
    }
  }
});

child.on('error', (err) => {
  console.error(`RPC spawn error: ${err.message}`);
  done(1);
});

function windowLabel(minutes) {
  if (minutes === 300) return '5h';
  if (minutes === 10080) return 'weekly';
  if (typeof minutes === 'number') return `${minutes}m`;
  return 'window';
}

function resetText(epochSeconds) {
  if (epochSeconds == null) return 'unknown';
  const d = new Date(epochSeconds * 1000);
  return d.toLocaleString();
}

(async () => {
  try {
    const init = await send('initialize', {
      clientInfo: { name: 'codexacct', version: '0.2.0' },
    });

    const accountResp = await send('account/read', { forceRefresh: refreshMode });
    const limitsResp = await send('account/rateLimits/read');

    const account = accountResp?.account || null;
    const snapshot = (limitsResp?.rateLimitsByLimitId && (limitsResp.rateLimitsByLimitId.codex || Object.values(limitsResp.rateLimitsByLimitId)[0]))
      || limitsResp?.rateLimits
      || null;

    if (!snapshot) {
      throw new Error('No rate limit snapshot returned by app-server');
    }

    const out = {
      codexHome: init?.codexHome || null,
      account,
      requiresOpenaiAuth: !!accountResp?.requiresOpenaiAuth,
      rateLimits: snapshot,
      rateLimitsByLimitId: limitsResp?.rateLimitsByLimitId || null,
    };

    if (jsonMode) {
      console.log(JSON.stringify(out, null, 2));
      done(0);
      return;
    }

    const email = account?.email || 'unknown';
    const plan = account?.planType || snapshot?.planType || 'unknown';
    const primary = snapshot?.primary || null;
    const secondary = snapshot?.secondary || null;
    const credits = snapshot?.credits || null;

    console.log(`email: ${email}`);
    console.log(`plan: ${plan}`);

    if (primary) {
      const used = Number(primary.usedPercent ?? 0);
      const rem = Math.max(0, 100 - used);
      console.log(`${windowLabel(primary.windowDurationMins)} used: ${used}%`);
      console.log(`${windowLabel(primary.windowDurationMins)} remaining: ${rem}%`);
      console.log(`${windowLabel(primary.windowDurationMins)} resets_at: ${resetText(primary.resetsAt)}`);
    } else {
      console.log('primary window: unavailable');
    }

    if (secondary) {
      const used = Number(secondary.usedPercent ?? 0);
      const rem = Math.max(0, 100 - used);
      console.log(`${windowLabel(secondary.windowDurationMins)} used: ${used}%`);
      console.log(`${windowLabel(secondary.windowDurationMins)} remaining: ${rem}%`);
      console.log(`${windowLabel(secondary.windowDurationMins)} resets_at: ${resetText(secondary.resetsAt)}`);
    } else {
      console.log('secondary window: unavailable');
    }

    if (credits) {
      console.log(`credits.hasCredits: ${credits.hasCredits}`);
      console.log(`credits.unlimited: ${credits.unlimited}`);
      console.log(`credits.balance: ${credits.balance == null ? 'null' : credits.balance}`);
    } else {
      console.log('credits: unavailable');
    }

    done(0);
  } catch (err) {
    console.error(`RPC usage probe failed: ${err.message}`);
    done(1);
  }
})();
NODE
}

collect_usage_targets() {
  echo "default|$DEFAULT_HOME"
  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    local name
    name="$(basename "$d")"
    echo "$name|$d"
  done
}

json_usage_to_tsv() {
  node -e '
const fs = require("fs");
const raw = fs.readFileSync(0, "utf8");
const data = JSON.parse(raw);
const r = data?.rateLimits || {};
const p = r?.primary || null;
const s = r?.secondary || null;
const email = data?.account?.email || "unknown";
const plan = data?.account?.planType || r?.planType || "unknown";

function pct(value) {
  return (typeof value === "number") ? `${value}%` : "-";
}

function rem(value) {
  return (typeof value === "number") ? `${Math.max(0, 100 - value)}%` : "-";
}

function reset(epochSeconds) {
  if (epochSeconds == null) return "-";
  const d = new Date(epochSeconds * 1000);
  const parts = new Intl.DateTimeFormat("sv-SE", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).formatToParts(d);
  const get = t => parts.find(p => p.type === t)?.value ?? "00";
  return `${get("year")}-${get("month")}-${get("day")} ${get("hour")}:${get("minute")}`;
}

const row = [
  email,
  plan,
  pct(p?.usedPercent),
  rem(p?.usedPercent),
  reset(p?.resetsAt),
  pct(s?.usedPercent),
  rem(s?.usedPercent),
  reset(s?.resetsAt),
];

process.stdout.write(row.join("\t"));
'
}

crop_cell() {
  local text="$1"
  local width="$2"
  if [ "${#text}" -le "$width" ]; then
    printf "%s" "$text"
    return 0
  fi
  if [ "$width" -le 3 ]; then
    printf "%s" "${text:0:$width}"
    return 0
  fi
  printf "%s..." "${text:0:$((width-3))}"
}

print_usage_table_header() {
  printf '+--------------+--------------------------------+----------+----------+----------+-------------------+----------+----------+-------------------+------------------+\n'
  printf '| %-12s | %-30s | %-8s | %-8s | %-8s | %-17s | %-8s | %-8s | %-17s | %-16s |\n' \
    "profile" "email" "plan" "5h_used" "5h_left" "5h_reset" "wk_used" "wk_left" "wk_reset" "status"
  printf '+--------------+--------------------------------+----------+----------+----------+-------------------+----------+----------+-------------------+------------------+\n'
}

print_usage_table_row() {
  local profile="$1"
  local email="$2"
  local plan="$3"
  local p_used="$4"
  local p_left="$5"
  local p_reset="$6"
  local s_used="$7"
  local s_left="$8"
  local s_reset="$9"
  local status="${10}"

  printf '| %-12s | %-30s | %-8s | %-8s | %-8s | %-17s | %-8s | %-8s | %-17s | %-16s |\n' \
    "$(crop_cell "$profile" 12)" \
    "$(crop_cell "$email" 30)" \
    "$(crop_cell "$plan" 8)" \
    "$(crop_cell "$p_used" 8)" \
    "$(crop_cell "$p_left" 8)" \
    "$(crop_cell "$p_reset" 17)" \
    "$(crop_cell "$s_used" 8)" \
    "$(crop_cell "$s_left" 8)" \
    "$(crop_cell "$s_reset" 17)" \
    "$(crop_cell "$status" 16)"
}

print_usage_table_footer() {
  printf '+--------------+--------------------------------+----------+----------+----------+-------------------+----------+----------+-------------------+------------------+\n'
}

cmd_login() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: codexacct login <profile> [extra login flags]"
  validate_profile "$profile"
  ensure_dirs

  local p_home
  p_home="$(profile_home "$profile")"
  mkdir -p "$p_home"

  echo "Logging in profile '$profile' at: $p_home"
  CODEX_HOME="$p_home" "$CODEX_BIN" login "$@"

  echo "Profile '$profile' login complete."
  echo "--- auth summary ($profile) ---"
  print_auth_summary "$(auth_file "$p_home")"
}

cmd_use() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: codexacct use <profile> [--force]"
  validate_profile "$profile"
  ensure_dirs

  local force="false"
  if [ "${1:-}" = "--force" ]; then
    force="true"
  fi

  local p_home src dst
  p_home="$(profile_home "$profile")"
  src="$(auth_file "$p_home")"
  dst="$(auth_file "$DEFAULT_HOME")"

  [ -f "$src" ] || die "Profile '$profile' has no auth.json. Run: codexacct login $profile"

  if is_codex_app_running && [ "$force" != "true" ]; then
    die "Codex App is running. Close it first, or use 'codexacct use $profile --force' if you accept in-flight risk."
  fi

  if [ -f "$dst" ]; then
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    cp "$dst" "$BACKUP_DIR/auth.$ts.json"
    chmod 600 "$BACKUP_DIR/auth.$ts.json" || true
    echo "Backup created: $BACKUP_DIR/auth.$ts.json"
  fi

  cp "$src" "$dst"
  chmod 600 "$dst" || true

  echo "Default profile switched to '$profile'."
  echo "--- auth summary (default) ---"
  print_auth_summary "$dst"
  echo "Tip: open/restart Codex App to ensure UI/session state reflects the new default account."
}

cmd_usage() {
  ensure_dirs

  local profile="default"
  local json_mode="false"
  local refresh_mode="false"
  local all_mode="false"
  local profile_set="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        all_mode="true"
        ;;
      --json)
        json_mode="true"
        ;;
      --refresh)
        refresh_mode="true"
        ;;
      default)
        profile="default"
        profile_set="true"
        ;;
      -h|--help)
        echo "Usage: codexacct usage [profile|default] [--all] [--json] [--refresh]"
        echo "Examples:"
        echo "  codexacct usage"
        echo "  codexacct usage trabajo"
        echo "  codexacct usage default --json"
        echo "  codexacct usage --all"
        return 0
        ;;
      *)
        if [[ "$1" == --* ]]; then
          die "Unknown option '$1'"
        fi
        if [ "$profile_set" = "true" ]; then
          die "Only one profile argument is allowed."
        fi
        profile="$1"
        profile_set="true"
        ;;
    esac
    shift
  done

  if [ "$all_mode" = "true" ]; then
    [ "$json_mode" != "true" ] || die "--all does not support --json yet."
    [ "$profile_set" != "true" ] || die "Do not pass profile/default with --all."

    echo "Usage source: codex app-server RPC"
    echo "Target profile: all"
    echo "Profiles root: $PROFILES_ROOT"
    if [ "$refresh_mode" = "true" ]; then
      echo "Mode: force refresh enabled"
    fi
    echo

    print_usage_table_header
    while IFS='|' read -r label target_home; do
      [ -n "$label" ] || continue

      local target_auth
      target_auth="$(auth_file "$target_home")"
      if [ ! -f "$target_auth" ]; then
        print_usage_table_row "$label" "-" "-" "-" "-" "-" "-" "-" "-" "no-auth"
        continue
      fi

      local rpc_json rpc_err tsv err_file
      err_file="$(mktemp)"
      if rpc_json="$(fetch_usage_via_rpc "$target_home" "true" "$refresh_mode" 2>"$err_file")"; then
        if tsv="$(printf "%s" "$rpc_json" | json_usage_to_tsv 2>/dev/null)"; then
          local email plan p_used p_left p_reset s_used s_left s_reset
          IFS=$'\t' read -r email plan p_used p_left p_reset s_used s_left s_reset <<<"$tsv"
          print_usage_table_row "$label" "$email" "$plan" "$p_used" "$p_left" "$p_reset" "$s_used" "$s_left" "$s_reset" "ok"
        else
          print_usage_table_row "$label" "-" "-" "-" "-" "-" "-" "-" "-" "parse-error"
        fi
      else
        rpc_err="$(cat "$err_file")"
        rpc_err="$(echo "$rpc_err" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
        local err_lc status
        err_lc="$(printf "%s" "$rpc_err" | tr '[:upper:]' '[:lower:]')"
        if [[ "$err_lc" == *"not logged in"* ]] || [[ "$err_lc" == *"requiresopenaiauth"* ]]; then
          status="not-logged"
        elif [[ "$err_lc" == *"no rate limit snapshot"* ]]; then
          status="no-limits"
        elif [[ "$err_lc" == *"timeout"* ]]; then
          status="timeout"
        else
          status="rpc-error"
        fi
        print_usage_table_row "$label" "-" "-" "-" "-" "-" "-" "-" "-" "$status"
      fi
      rm -f "$err_file"
    done < <(collect_usage_targets)
    print_usage_table_footer
    return 0
  fi

  local target_home label
  if [ "$profile" = "default" ]; then
    target_home="$DEFAULT_HOME"
    label="default"
  else
    validate_profile "$profile"
    target_home="$(profile_home "$profile")"
    [ -d "$target_home" ] || die "Profile '$profile' does not exist"
    label="$profile"
  fi

  [ -f "$(auth_file "$target_home")" ] || die "No auth.json found for '$label' at $target_home"

  if [ "$json_mode" != "true" ]; then
    echo "Usage source: codex app-server RPC"
    echo "Target profile: $label"
    echo "CODEX_HOME: $target_home"
    if [ "$refresh_mode" = "true" ]; then
      echo "Mode: force refresh enabled"
    fi
    echo
  fi

  fetch_usage_via_rpc "$target_home" "$json_mode" "$refresh_mode"
}

cmd_list() {
  ensure_dirs

  local default_auth default_account
  default_auth="$(auth_file "$DEFAULT_HOME")"
  default_account=""
  if [ -f "$default_auth" ]; then
    default_account="$(node -e 'const fs=require("fs");const p=process.argv[1];try{const j=JSON.parse(fs.readFileSync(p,"utf8"));process.stdout.write(j?.tokens?.account_id||"");}catch{process.stdout.write("");}' "$default_auth")"
  fi

  echo "Default home: $DEFAULT_HOME"
  if [ -f "$default_auth" ]; then
    echo "Default account_id: ${default_account:-unknown}"
  else
    echo "Default account_id: (not logged in)"
  fi
  echo

  local found="false"
  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    found="true"
    local name a
    name="$(basename "$d")"
    a="$(auth_file "$d")"

    local acc
    if [ -f "$a" ]; then
      acc="$(node -e 'const fs=require("fs");const p=process.argv[1];try{const j=JSON.parse(fs.readFileSync(p,"utf8"));process.stdout.write(j?.tokens?.account_id||"");}catch{process.stdout.write("");}' "$a")"
      local mark=" "
      if [ -n "$default_account" ] && [ "$acc" = "$default_account" ]; then
        mark="*"
      fi
      echo "[$mark] $name"
      print_auth_summary "$a" | sed 's/^/    /'
    else
      echo "[ ] $name"
      echo "    auth: missing"
    fi
    echo
  done

  if [ "$found" = "false" ]; then
    echo "No profiles yet. Create one with: codexacct login <profile>"
  fi

  echo "Legend: '*' means same account_id as current default ~/.codex/auth.json"
}

cmd_whoami() {
  ensure_dirs
  local d_auth
  d_auth="$(auth_file "$DEFAULT_HOME")"
  echo "Default home: $DEFAULT_HOME"
  "$CODEX_BIN" login status || true
  echo "--- auth summary (default) ---"
  print_auth_summary "$d_auth"
}

cmd_status() {
  local profile="${1:-}"
  [ -n "$profile" ] || die "Usage: codexacct status <profile>"
  validate_profile "$profile"

  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"

  CODEX_HOME="$p_home" "$CODEX_BIN" login status || true
  echo "--- auth summary ($profile) ---"
  print_auth_summary "$(auth_file "$p_home")"
}

cmd_logout() {
  local profile="${1:-}"
  [ -n "$profile" ] || die "Usage: codexacct logout <profile>"
  validate_profile "$profile"
  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"
  CODEX_HOME="$p_home" "$CODEX_BIN" logout || true
  echo "Logged out profile '$profile'"
}

cmd_logout_default() {
  "$CODEX_BIN" logout || true
  echo "Logged out default profile ($DEFAULT_HOME)"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    login) cmd_login "$@" ;;
    use) cmd_use "$@" ;;
    usage|limits) cmd_usage "$@" ;;
    list) cmd_list ;;
    whoami) cmd_whoami ;;
    status) cmd_status "$@" ;;
    logout) cmd_logout "$@" ;;
    logout-default) cmd_logout_default ;;
    help|-h|--help) usage ;;
    *) die "Unknown command '$cmd'. Run: codexacct help" ;;
  esac
}

main "$@"
