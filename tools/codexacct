#!/usr/bin/env bash
set -euo pipefail

DEFAULT_HOME="${CODEX_DEFAULT_HOME:-$HOME/.codex}"
PROFILES_ROOT="${CODEX_PROFILES_HOME:-$HOME/.codex-profiles}"
CODEX_BIN="${CODEX_BIN:-codex}"
BACKUP_DIR="$DEFAULT_HOME/backups"

usage() {
  cat <<USAGE
codexacct - Multi-account profile manager for Codex default home

Usage:
  codexacct login <profile> [--device-auth|extra codex login flags]
  codexacct use <profile> [--force] [--relaunch]
  codexacct usage [profile|default] [--all] [--json] [--refresh]
  codexacct limits [profile|default] [--all] [--json] [--refresh]
  codexacct list
  codexacct whoami
  codexacct status <profile> [--refresh]
  codexacct logout <profile>
  codexacct logout-default

Core flow:
  1) Save credentials per profile:  codexacct login personal
  2) Switch active default account: codexacct use personal
  3) Check usage/rate limits:       codexacct usage default
  4) Compare all profiles:          codexacct usage --all

Notes:
  - Default Codex App + CLI home is: $DEFAULT_HOME
  - Profile homes are stored in:      $PROFILES_ROOT/<profile>
  - 'use' copies <profile>/auth.json into $DEFAULT_HOME/auth.json
  - 'usage' uses Codex app-server RPC (account/read + account/rateLimits/read)
USAGE
}

die() {
  echo "Error: $*" >&2
  exit 1
}

ensure_dirs() {
  mkdir -p "$DEFAULT_HOME" "$PROFILES_ROOT" "$BACKUP_DIR"
}

validate_profile() {
  local profile="$1"
  [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile name '$profile'. Use letters, numbers, dot, underscore, or dash."
}

profile_home() {
  echo "$PROFILES_ROOT/$1"
}

auth_file() {
  echo "$1/auth.json"
}

supports_color() {
  if ! [ -t 1 ] && ! [ -t 2 ]; then
    return 1
  fi
  [ -n "${NO_COLOR:-}" ] && return 1
  return 0
}

color_cyan() {
  local text="$1"
  if supports_color; then
    printf '\033[36m%s\033[0m' "$text"
  else
    printf '%s' "$text"
  fi
}

color_green() {
  local text="$1"
  if supports_color; then
    printf '\033[32m%s\033[0m' "$text"
  else
    printf '%s' "$text"
  fi
}

color_green_bold() {
  local text="$1"
  if supports_color; then
    printf '\033[1;32m%s\033[0m' "$text"
  else
    printf '%s' "$text"
  fi
}

color_gray() {
  local text="$1"
  if supports_color; then
    printf '\033[90m%s\033[0m' "$text"
  else
    printf '%s' "$text"
  fi
}

render_percent_bar() {
  local percent_text="$1"
  local width=20

  if [[ ! "$percent_text" =~ ^[0-9]+%$ ]]; then
    printf '[--------------------]'
    return 0
  fi

  local pct="${percent_text%%%}"
  if [ "$pct" -lt 0 ]; then pct=0; fi
  if [ "$pct" -gt 100 ]; then pct=100; fi

  local filled=$((pct * width / 100))
  local empty=$((width - filled))
  local filled_str empty_str
  filled_str="$(printf '%*s' "$filled" '' | tr ' ' '#')"
  empty_str="$(printf '%*s' "$empty" '' | tr ' ' '-')"
  printf '[%s%s]' "$filled_str" "$empty_str"
}

renewal_hint_text() {
  local rel="$1"
  if [ -z "$rel" ] || [ "$rel" = "-" ] || [ "$rel" = "unknown" ]; then
    echo "renews unknown"
    return 0
  fi
  if [[ "$rel" == *"ago" ]]; then
    echo "renewed $rel"
    return 0
  fi
  echo "renews $rel"
}

compact_window_cell() {
  local remaining="$1"
  local reset="$2"

  if [ -z "$remaining" ] || [ "$remaining" = "-" ]; then
    echo "-"
    return 0
  fi

  if [ -z "$reset" ] || [ "$reset" = "-" ]; then
    echo "$remaining (-)"
    return 0
  fi

  echo "$remaining ($reset)"
}

format_credits_line() {
  local has="$1"
  local unlimited="$2"
  local balance="$3"

  if [ "$has" = "false" ]; then
    echo "credits: none"
    return 0
  fi

  if [ "$has" = "true" ] && [ "$unlimited" = "true" ]; then
    echo "credits: unlimited"
    return 0
  fi

  if [ "$has" = "true" ]; then
    if [ "$balance" = "null" ] || [ "$balance" = "-" ] || [ -z "$balance" ]; then
      echo "credits: available"
    else
      echo "credits: balance $balance"
    fi
    return 0
  fi

  echo "credits: unknown"
}

is_codex_app_running() {
  if command -v osascript >/dev/null 2>&1; then
    local running
    running="$(osascript -e 'tell application "System Events" to (name of processes) contains "Codex"' 2>/dev/null || true)"
    [ "$running" = "true" ] && return 0
  fi

  pgrep -f "/Applications/Codex.app/Contents/MacOS/Codex" >/dev/null 2>&1
}

quit_codex_app() {
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'tell application "Codex" to quit' >/dev/null 2>&1 || true
  fi

  local i
  for i in $(seq 1 20); do
    if ! is_codex_app_running; then
      return 0
    fi
    sleep 0.25
  done

  return 1
}

open_codex_app() {
  open -a Codex >/dev/null 2>&1
}

auth_fingerprint() {
  local auth_path="$1"
  [ -f "$auth_path" ] || {
    echo ""
    return 0
  }

  node - "$auth_path" <<'NODE'
const fs = require('fs');
const crypto = require('crypto');
const p = process.argv[2];
try {
  const j = JSON.parse(fs.readFileSync(p, 'utf8'));
  const token = j?.tokens?.refresh_token || '';
  const hash = crypto.createHash('sha256').update(token).digest('hex');
  process.stdout.write(hash.slice(0, 16));
} catch {
  process.stdout.write('');
}
NODE
}

auth_account_id() {
  local auth_path="$1"
  [ -f "$auth_path" ] || {
    echo ""
    return 0
  }

  node - "$auth_path" <<'NODE'
const fs = require('fs');
const p = process.argv[2];
try {
  const j = JSON.parse(fs.readFileSync(p, 'utf8'));
  process.stdout.write(j?.tokens?.account_id || '');
} catch {
  process.stdout.write('');
}
NODE
}

detect_active_profile() {
  local default_auth default_fp default_account
  default_auth="$(auth_file "$DEFAULT_HOME")"
  [ -f "$default_auth" ] || {
    echo "(not logged in)"
    return 0
  }

  default_fp="$(auth_fingerprint "$default_auth")"
  default_account="$(auth_account_id "$default_auth")"

  local exact_matches=()
  local account_matches=()

  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    local name profile_auth profile_fp profile_account
    name="$(basename "$d")"
    profile_auth="$(auth_file "$d")"
    [ -f "$profile_auth" ] || continue

    profile_fp="$(auth_fingerprint "$profile_auth")"
    profile_account="$(auth_account_id "$profile_auth")"

    if [ -n "$default_fp" ] && [ -n "$profile_fp" ] && [ "$profile_fp" = "$default_fp" ]; then
      exact_matches+=("$name")
    elif [ -n "$default_account" ] && [ "$profile_account" = "$default_account" ]; then
      account_matches+=("$name")
    fi
  done

  if [ "${#exact_matches[@]}" -eq 1 ]; then
    echo "${exact_matches[0]}"
    return 0
  fi

  if [ "${#exact_matches[@]}" -gt 1 ]; then
    local joined
    joined="$(IFS=', '; echo "${exact_matches[*]}")"
    echo "ambiguous-token ($joined)"
    return 0
  fi

  if [ "${#account_matches[@]}" -eq 1 ]; then
    echo "${account_matches[0]} (same account_id)"
    return 0
  fi

  if [ "${#account_matches[@]}" -gt 1 ]; then
    local joined
    joined="$(IFS=', '; echo "${account_matches[*]}")"
    echo "unmapped-token (same account_id in: $joined)"
    return 0
  fi

  echo "(unmapped)"
}

normalized_active_profile() {
  local active_profile
  active_profile="$(detect_active_profile)"

  if [ -z "$active_profile" ]; then
    echo ""
    return 0
  fi

  if [ "$active_profile" = "(not logged in)" ] || [ "$active_profile" = "(unmapped)" ]; then
    echo ""
    return 0
  fi

  if [[ "$active_profile" == *"("* ]]; then
    echo ""
    return 0
  fi

  echo "$active_profile"
}

print_auth_summary() {
  local auth_path="$1"
  [ -f "$auth_path" ] || {
    echo "auth: missing ($auth_path)"
    return 0
  }

  node - "$auth_path" <<'NODE'
const fs = require('fs');
const p = process.argv[2];
try {
  const j = JSON.parse(fs.readFileSync(p, 'utf8'));
  const accountId = j?.tokens?.account_id || 'unknown';
  let email = 'unknown';
  let plan = 'unknown';
  let org = 'unknown';
  const supportsColor = Boolean(process.stdout.isTTY) && !process.env.NO_COLOR;
  const yellow = '\x1b[33m';
  const reset = '\x1b[0m';
  const id = j?.tokens?.id_token;
  if (id && id.includes('.')) {
    const payload = JSON.parse(Buffer.from(id.split('.')[1], 'base64url').toString('utf8'));
    email = payload?.email || email;
    const auth = payload?.['https://api.openai.com/auth'] || {};
    plan = auth?.chatgpt_plan_type || plan;
    const orgs = Array.isArray(auth?.organizations) ? auth.organizations : [];
    const defOrg = orgs.find(o => o && o.is_default) || orgs[0];
    if (defOrg && defOrg.title) org = defOrg.title;
  }
  console.log(`account_id: ${accountId}`);
  if (supportsColor) {
    console.log(`email: ${yellow}${email}${reset}`);
  } else {
    console.log(`email: ${email}`);
  }
  console.log(`plan: ${plan}`);
  console.log(`default_org: ${org}`);
} catch (e) {
  console.log(`auth parse error: ${e.message}`);
}
NODE
}

