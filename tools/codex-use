print_usage_table_row_for_home() {
  local label="$1"
  local target_home="$2"
  local refresh_mode="$3"
  local mark_active="${4:-false}"
  local live_only="${5:-false}"
  local allow_cache="${6:-false}"
  local backend_mode="${7:-auto}"

  local display_label="$label"
  if [ "$mark_active" = "true" ]; then
    display_label="${display_label}*"
  fi

  local target_auth
  target_auth="$(auth_file "$target_home")"
  if [ ! -f "$target_auth" ]; then
    print_usage_table_row "$display_label" "no-auth" "-" "-" "false"
    return 0
  fi

  local rpc_json rpc_err tsv err_file fetch_status
  err_file="$(mktemp)"
  if rpc_json="$(fetch_usage_with_cache "$target_home" "true" "$refresh_mode" "$live_only" "$allow_cache" "$backend_mode" 2>"$err_file")"; then
    fetch_status=0
  else
    fetch_status=$?
  fi

  if [ "$fetch_status" -eq 0 ] || [ "$fetch_status" -eq 10 ]; then
    if tsv="$(printf "%s" "$rpc_json" | json_usage_to_tsv 2>/dev/null)"; then
      local email plan p_left p_reset s_left s_reset five_h_cell weekly_cell row_status
      IFS=$'\t' read -r email plan p_left p_reset s_left s_reset <<<"$tsv"
      row_status="true"
      if [ "$fetch_status" -eq 10 ]; then
        row_status="cached"
        email="${email} (cached)"
      fi
      five_h_cell="$(compact_window_cell "$p_left" "$p_reset")"
      weekly_cell="$(compact_window_cell "$s_left" "$s_reset")"
      print_usage_table_row "$display_label" "$email" "$five_h_cell" "$weekly_cell" "$row_status"
    else
      print_usage_table_row "$display_label" "parse-error" "-" "-" "false"
    fi
  else
    rpc_err="$(cat "$err_file")"
    rpc_err="$(echo "$rpc_err" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    local status
    status="$(classify_usage_error_reason "$rpc_err")"
    print_usage_table_row "$display_label" "$status" "-" "-" "false"
  fi
  rm -f "$err_file"
}

cmd_login() {
