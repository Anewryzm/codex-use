fetch_usage_with_cache() {
  local target_home="$1"
  local _json_mode="${2:-true}"
  local refresh_mode="${3:-false}"
  local live_only="${4:-false}"
  local allow_cache="${5:-false}"
  local backend_mode="${6:-auto}"
  local normalized_backend
  normalized_backend="$(normalize_backend_mode "$backend_mode" || true)"
  [ -n "$normalized_backend" ] || normalized_backend="auto"

  if [ "$live_only" = "true" ]; then
    allow_cache="false"
  fi

  local use_wham="false"
  local use_rpc="false"
  case "$normalized_backend" in
    auto)
      use_wham="true"
      use_rpc="true"
      ;;
    wham)
      use_wham="true"
      ;;
    rpc)
      use_rpc="true"
      ;;
  esac

  local live_json live_source
  local err_agg=""
  local err_file err_text rc

  if [ "$refresh_mode" = "true" ]; then
    if ! refresh_auth_via_rpc "$target_home" >/dev/null 2>&1; then
      err_agg="${err_agg}[refresh] token refresh probe failed before live fetch\n"
    fi
  fi

  if [ "$use_wham" = "true" ]; then
    err_file="$(mktemp)"
    if live_json="$(fetch_usage_via_wham "$target_home" 2>"$err_file")"; then
      rm -f "$err_file"
      live_source="wham"
    else
      rc=$?
      err_text="$(cat "$err_file" 2>/dev/null || true)"
      rm -f "$err_file"
      [ -z "$err_text" ] || err_agg="${err_agg}[wham] ${err_text}\n"
      if [ "$rc" -eq 2 ]; then
        if refresh_auth_via_rpc "$target_home" >/dev/null 2>&1; then
          err_file="$(mktemp)"
          if live_json="$(fetch_usage_via_wham "$target_home" 2>"$err_file")"; then
            rm -f "$err_file"
            live_source="wham"
          else
            err_text="$(cat "$err_file" 2>/dev/null || true)"
            rm -f "$err_file"
            [ -z "$err_text" ] || err_agg="${err_agg}[wham-retry] ${err_text}\n"
          fi
        else
          err_agg="${err_agg}[refresh] token refresh failed after auth-expired\n"
        fi
      fi
    fi
  fi

  if [ -z "$live_source" ] && [ "$use_rpc" = "true" ]; then
    err_file="$(mktemp)"
    if live_json="$(fetch_usage_via_rpc "$target_home" "true" "$refresh_mode" 2>"$err_file")"; then
      rm -f "$err_file"
      live_source="rpc"
    else
      err_text="$(cat "$err_file" 2>/dev/null || true)"
      rm -f "$err_file"
      [ -z "$err_text" ] || err_agg="${err_agg}[rpc] ${err_text}\n"
    fi
  fi

  if [ -n "$live_source" ]; then
    write_limits_cache "$target_home" "$live_json" "$live_source" || true
    printf "%s" "$live_json"
    return 0
  fi

  local cached_json
  if cached_json="$(read_limits_cache_decorated "$target_home")"; then
    if [ "$allow_cache" != "true" ]; then
      [ -z "$err_agg" ] || printf "%b" "$err_agg" >&2
      return 1
    fi
    local cache_file
    cache_file="$(limits_cache_file "$target_home")"
    [ -z "$err_agg" ] || printf "%b" "$err_agg" >&2
    echo "Live usage probe failed; using cached limits snapshot from $cache_file" >&2
    printf "%s" "$cached_json"
    return 10
  fi

  [ -z "$err_agg" ] || printf "%b" "$err_agg" >&2
  return 1
}

