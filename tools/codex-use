      [ -n "$in_val$cache_val$out_val" ] || die "Pass at least one of: --in, --cache, --out"
      if ! node - "$in_val" "$cache_val" "$out_val" <<'NODE' >/dev/null
const vals = process.argv.slice(2);
for (const v of vals) {
