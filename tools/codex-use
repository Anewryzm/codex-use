fetch_usage_via_wham() {
  local target_home="$1"

  node - "$target_home" <<'NODE'
const fs = require('fs');
const path = require('path');
const https = require('https');

const targetHome = process.argv[2];
const authPath = path.join(targetHome, 'auth.json');
const usageUrl = 'https://chatgpt.com/backend-api/wham/usage';

function fail(code, msg) {
  if (msg) process.stderr.write(msg + '\n');
  process.exit(code);
}

function readAuth() {
  let data;
  try {
    data = JSON.parse(fs.readFileSync(authPath, 'utf8'));
  } catch (err) {
    fail(3, `WHAM usage probe failed: unable to read auth.json at ${authPath}: ${err.message}`);
  }
  return data;
}

function normalizeWindow(window) {
  if (!window || typeof window !== 'object') return null;
  const used = Number(window.used_percent);
  const limitSecs = Number(window.limit_window_seconds);
  const resetAfter = Number(window.reset_after_seconds);
  const resetAtRaw = Number(window.reset_at);

  let resetsAt = null;
  if (Number.isFinite(resetAtRaw) && resetAtRaw > 0) {
    resetsAt = Math.floor(resetAtRaw);
  } else if (Number.isFinite(resetAfter)) {
    resetsAt = Math.floor(Date.now() / 1000 + resetAfter);
  }

  return {
    usedPercent: Number.isFinite(used) ? Math.max(0, Math.min(100, used)) : null,
    windowDurationMins: Number.isFinite(limitSecs) && limitSecs > 0
      ? Math.round(limitSecs / 60)
      : null,
    resetsAt,
  };
}

function normalizeResponse(payload, auth) {
  const rateLimit = payload?.rate_limit || {};
  const primary = normalizeWindow(rateLimit.primary_window);
  const secondary = normalizeWindow(rateLimit.secondary_window);
  const creditsRaw = payload?.credits || null;
  const credits = creditsRaw ? {
    hasCredits: !!creditsRaw.has_credits,
    unlimited: !!creditsRaw.unlimited,
    balance: creditsRaw.balance == null ? null : creditsRaw.balance,
  } : null;

  return {
    codexHome: targetHome,
    account: {
      email: payload?.email || null,
      accountId: payload?.account_id || auth?.tokens?.account_id || null,
      planType: payload?.plan_type || null,
    },
    requiresOpenaiAuth: false,
    rateLimits: {
      planType: payload?.plan_type || null,
      primary,
      secondary,
      credits,
    },
    rateLimitsByLimitId: null,
    _codexUseLive: {
      source: 'wham',
      fetchedAt: Math.floor(Date.now() / 1000),
    },
    _codexUseWham: {
      allowed: !!rateLimit.allowed,
      limitReached: !!rateLimit.limit_reached,
      codeReviewRateLimit: payload?.code_review_rate_limit || null,
      additionalRateLimits: payload?.additional_rate_limits || null,
      rateLimitReachedType: payload?.rate_limit_reached_type || null,
    },
  };
}

function requestWham(token) {
  return new Promise((resolve, reject) => {
    const req = https.request({
      method: 'GET',
      hostname: 'chatgpt.com',
      path: '/backend-api/wham/usage',
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/json',
        'User-Agent': 'dex/0.2.0',
      },
    }, (res) => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', (chunk) => { body += chunk; });
      res.on('end', () => resolve({ statusCode: Number(res.statusCode || 0), body }));
    });

    req.setTimeout(20000, () => {
      req.destroy(new Error('timeout for wham/usage'));
    });

    req.on('error', (err) => reject(err));
    req.end();
  });
}

(async () => {
  const auth = readAuth();
  const accessToken = auth?.tokens?.access_token;
  if (!accessToken) {
    fail(3, 'WHAM usage probe failed: not logged in (missing access token)');
  }

  let res;
  try {
    res = await requestWham(accessToken);
  } catch (err) {
    fail(
      4,
      `WHAM usage probe failed: error sending request for url (${usageUrl}): ${err.message}`
    );
  }

  const status = Number(res?.statusCode || 0);
  let payload = null;
  try {
    payload = JSON.parse(res?.body || '{}');
  } catch {
    payload = null;
  }

  if (status === 401 || status === 403) {
    fail(2, `WHAM usage probe failed: wham-http-${status} auth-expired`);
  }

  if (status !== 200) {
    const summary = (res?.body || '').toString().replace(/\s+/g, ' ').slice(0, 220);
    fail(1, `WHAM usage probe failed: wham-http-${status} ${summary}`);
  }

  if (!payload || typeof payload !== 'object') {
    fail(1, 'WHAM usage probe failed: malformed response payload');
  }

  const out = normalizeResponse(payload, auth);
  process.stdout.write(JSON.stringify(out, null, 2));
})().catch((err) => {
  fail(1, `WHAM usage probe failed: ${err.message}`);
});
NODE
}

fetch_usage_via_rpc() {
  local target_home="$1"
  local json_mode="$2"
  local refresh_mode="$3"
  local force_file_auth="${CODEX_FORCE_FILE_AUTH:-1}"

  CODEX_HOME="$target_home" node - "$CODEX_BIN" "$json_mode" "$refresh_mode" "$force_file_auth" <<'NODE'
const { spawn } = require('child_process');

const codexBin = process.argv[2] || 'codex';
const jsonMode = process.argv[3] === 'true';
const refreshMode = process.argv[4] === 'true';
const forceFileAuth = ['1', 'true'].includes(String(process.argv[5] || '').toLowerCase());

const childArgs = forceFileAuth
  ? ['-c', 'cli_auth_credentials_store="file"', 'app-server']
  : ['app-server'];
const child = spawn(codexBin, childArgs, { stdio: ['pipe', 'pipe', 'pipe'] });
let buf = '';
let settled = false;
let seq = 1;
const pending = new Map();

function done(code) {
  if (settled) return;
  settled = true;
  try { child.kill('SIGTERM'); } catch {}
  setTimeout(() => process.exit(code), 80);
}

function send(method, params, timeoutMs = 12000) {
  const id = seq++;
  const msg = { jsonrpc: '2.0', id, method };
  if (params !== undefined) msg.params = params;
  child.stdin.write(JSON.stringify(msg) + '\n');
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => {
      pending.delete(id);
      reject(new Error(`timeout for ${method}`));
    }, timeoutMs);
    pending.set(id, { resolve, reject, t });
  });
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function isRetryableRateLimitErr(msg) {
  const s = String(msg || '').toLowerCase();
  return (
    s.includes('failed to fetch codex rate limits')
    || s.includes('error sending request for url')
    || s.includes('dns error')
    || s.includes('connection refused')
    || s.includes('network is unreachable')
    || s.includes('connection reset')
    || s.includes('temporarily unavailable')
    || s.includes('timeout')
    || s.includes('timed out')
    || s.includes('http status 429')
    || s.includes('http status 500')
    || s.includes('http status 502')
    || s.includes('http status 503')
    || s.includes('http status 504')
  );
}

async function readAccountWithCompat() {
  try {
    return await send('account/read', { refreshToken: refreshMode }, 12000);
  } catch (err) {
    // Older app-server builds used forceRefresh.
    return await send('account/read', { forceRefresh: refreshMode }, 12000);
  }
}

async function readRateLimitsWithRetry() {
  const attempts = 3;
  let lastErr = null;
  for (let attempt = 1; attempt <= attempts; attempt++) {
    try {
      return await send('account/rateLimits/read', undefined, 20000);
    } catch (err) {
      lastErr = err;
      if (attempt >= attempts || !isRetryableRateLimitErr(err?.message || err)) {
        throw err;
      }
      await sleep(400 * attempt);
    }
  }
  throw lastErr || new Error('failed to fetch codex rate limits');
}

