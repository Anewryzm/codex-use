backup_sessions_summary_tsv() {
  local sessions_root="$1"
  node - "$sessions_root" <<'NODE'
const fs = require("fs");
const path = require("path");

const sessionsRoot = process.argv[2];

function walkJsonlFiles(dir, out = []) {
  if (!fs.existsSync(dir)) return out;
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walkJsonlFiles(p, out);
    else if (e.isFile() && p.endsWith(".jsonl")) out.push(p);
  }
  return out;
}

function asNumber(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
}

const files = walkJsonlFiles(sessionsRoot).sort();
const selectedFilesBySession = new Map();
for (const file of files) {
  let content = "";
  try {
    content = fs.readFileSync(file, "utf8");
  } catch {
    continue;
  }
  if (!content) continue;
  const lines = content.split("\n");
  let sessionId = null;
  let maxTotalInFile = 0;
  for (const line of lines) {
    if (!line) continue;
    let event;
    try {
      event = JSON.parse(line);
    } catch {
      continue;
    }
    if (event.type === "session_meta" && !sessionId) {
      sessionId = event?.payload?.id || sessionId;
    }
    if (event.type === "event_msg" && event?.payload?.type === "token_count") {
      const t = event?.payload?.info?.total_token_usage;
      if (!t || typeof t !== "object") continue;
      maxTotalInFile = Math.max(maxTotalInFile, asNumber(t.total_tokens));
    }
  }
  const key = sessionId || file;
  const prev = selectedFilesBySession.get(key);
  if (!prev || maxTotalInFile >= prev.maxTotalInFile) {
    selectedFilesBySession.set(key, { file, maxTotalInFile });
  }
}

const totals = {
  input: 0,
  cached: 0,
  outputWithReasoning: 0,
  total: 0,
  sessions: 0,
};
const models = new Set();

for (const { file } of selectedFilesBySession.values()) {
  let content = "";
  try {
    content = fs.readFileSync(file, "utf8");
  } catch {
    continue;
  }
  if (!content) continue;
  const lines = content.split("\n");
  let currentModel = "unknown";
  let seenAnySnapshot = false;
  let prev = {
    input: 0,
    cached: 0,
    output: 0,
    reasoning: 0,
    total: 0,
  };
  const seenModelsInSession = new Set();

  for (const line of lines) {
    if (!line) continue;
    let event;
    try {
      event = JSON.parse(line);
    } catch {
      continue;
    }

    if (event.type === "turn_context" && event?.payload?.model) {
      currentModel = event.payload.model;
      seenModelsInSession.add(currentModel);
      continue;
    }

    if (event.type !== "event_msg" || event?.payload?.type !== "token_count") {
      continue;
    }
    const t = event?.payload?.info?.total_token_usage;
    if (!t || typeof t !== "object") continue;
    seenAnySnapshot = true;

    const cur = {
      input: asNumber(t.input_tokens),
      cached: asNumber(t.cached_input_tokens),
      output: asNumber(t.output_tokens),
      reasoning: asNumber(t.reasoning_output_tokens),
      total: asNumber(t.total_tokens),
    };
    const delta = {
      input: Math.max(0, cur.input - prev.input),
      cached: Math.max(0, cur.cached - prev.cached),
      output: Math.max(0, cur.output - prev.output),
      reasoning: Math.max(0, cur.reasoning - prev.reasoning),
      total: Math.max(0, cur.total - prev.total),
    };

    totals.input += delta.input;
    totals.cached += delta.cached;
    totals.outputWithReasoning += delta.output + delta.reasoning;
    totals.total += delta.total;
    prev = cur;
  }

  if (seenAnySnapshot) {
    totals.sessions += 1;
    if (seenModelsInSession.size === 0) seenModelsInSession.add("unknown");
    for (const m of seenModelsInSession) models.add(m);
  }
}

const out = [
  String(totals.sessions),
  String(totals.total),
  String(totals.input),
  String(totals.cached),
  String(totals.outputWithReasoning),
  Array.from(models).sort().join(","),
];
process.stdout.write(out.join("\t"));
NODE
}

count_jsonl_files() {
  local root="$1"
  if [ ! -d "$root" ]; then
    echo "0"
    return 0
  fi
  find "$root" -type f -name '*.jsonl' | wc -l | tr -d ' '
}

latest_mtime_epoch_for_pattern() {
  local root="$1"
  local pattern="$2"
  local latest
  latest="0"
  if [ ! -d "$root" ]; then
    echo "0"
    return 0
  fi
  while IFS= read -r -d '' file_path; do
    local mtime
    mtime="$(stat -f '%m' "$file_path" 2>/dev/null || echo "0")"
    if [ "$mtime" -gt "$latest" ] 2>/dev/null; then
      latest="$mtime"
    fi
  done < <(find "$root" -type f -name "$pattern" -print0 2>/dev/null)
  echo "$latest"
}

format_epoch_local() {
  local epoch="$1"
  if [ -z "$epoch" ] || [ "$epoch" -le 0 ] 2>/dev/null; then
    echo "-"
    return 0
  fi
  date -r "$epoch" +'%Y-%m-%d %H:%M:%S %z'
}

latest_runtime_epoch() {
  local latest
  latest="0"
  local runtime_files
  runtime_files=(
    "$DEFAULT_HOME/logs_2.sqlite"
    "$DEFAULT_HOME/state_5.sqlite"
    "$DEFAULT_HOME/session_index.jsonl"
  )
  local file_path
  for file_path in "${runtime_files[@]}"; do
    if [ -f "$file_path" ]; then
      local mtime
      mtime="$(stat -f '%m' "$file_path" 2>/dev/null || echo "0")"
      if [ "$mtime" -gt "$latest" ] 2>/dev/null; then
        latest="$mtime"
      fi
    fi
  done
  echo "$latest"
}

backup_session_id_coverage_tsv() {
  local source_root="$1"
  local backup_root="$2"
  node - "$source_root" "$backup_root" <<'NODE'
const fs = require("fs");
const path = require("path");

const sourceRoot = process.argv[2];
const backupRoot = process.argv[3];

function walkJsonlFiles(dir, out = []) {
  if (!fs.existsSync(dir)) return out;
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walkJsonlFiles(p, out);
    else if (e.isFile() && p.endsWith(".jsonl")) out.push(p);
  }
  return out;
}

function scanIds(root) {
  const ids = new Set();
  const files = walkJsonlFiles(root);
  for (const f of files) {
    let text = "";
    try {
      text = fs.readFileSync(f, "utf8");
    } catch {
      continue;
    }
    const lines = text.split("\n");
    for (const line of lines) {
      if (!line) continue;
      let evt;
      try {
        evt = JSON.parse(line);
      } catch {
        continue;
      }
      if (evt?.type === "session_meta" && evt?.payload?.id) {
        ids.add(String(evt.payload.id));
        break;
      }
    }
  }
  return ids;
}

const sourceIds = scanIds(sourceRoot);
const backupIds = scanIds(backupRoot);
let shared = 0;
for (const id of sourceIds) {
  if (backupIds.has(id)) shared += 1;
}

process.stdout.write([
  String(sourceIds.size),
  String(backupIds.size),
  String(shared),
].join("\t"));
NODE
}

backup_pending_copy_breakdown_tsv() {
  local source_root="$1"
  local backup_root="$2"
  mkdir -p "$backup_root"
  rsync -anic --out-format='%i\t%n' "$source_root/" "$backup_root/" \
    | awk -F '\t' '
      /\.jsonl$/ {
        item=$1
        if (item ~ /^>f/) {
          transfer++
          if (item ~ /\+/) {
            added++
          } else {
            modified++
          }
        }
      }
      END { print transfer+0 "\t" added+0 "\t" modified+0 }
    '
}

backup_pending_delete_count() {
  local source_root="$1"
  local backup_root="$2"
  if [ ! -d "$backup_root" ]; then
    echo "0"
    return 0
  fi
  rsync -ani --delete "$source_root/" "$backup_root/" \
    | awk '/^\*deleting .*\.jsonl$/ { c++ } END { print c+0 }'
}

backup_session_notes_tsv() {
  local repo_dir="$1"
  local state_db="$DEFAULT_HOME/state_5.sqlite"
  local diff_file
  diff_file="$(mktemp)"
  git -C "$repo_dir" diff --cached --name-status -- sessions > "$diff_file"
  node - "$repo_dir" "$state_db" "$diff_file" <<'NODE'
const fs = require("fs");
const path = require("path");
const { execSync } = require("child_process");

const repoDir = process.argv[2];
const stateDb = process.argv[3];
const diffPath = process.argv[4];
const input = fs.readFileSync(diffPath, "utf8");
const lines = input.split(/\r?\n/).filter(Boolean);

const changed = [];
for (const line of lines) {
  const parts = line.split(/\t+/);
  const status = parts[0] || "";
  const relPath = parts[1] || "";
  if (!/^[AM]$/.test(status)) continue;
  if (!relPath.endsWith(".jsonl")) continue;
  changed.push({ status, relPath });
}

const titles = new Map();
if (fs.existsSync(stateDb)) {
  try {
    const raw = execSync(
      `sqlite3 -tabs "${stateDb}" "select id || char(9) || title from threads;"`,
      { encoding: "utf8" },
    ).trim();
    if (raw) {
      for (const row of raw.split(/\r?\n/)) {
        const tab = row.indexOf("\t");
        if (tab <= 0) continue;
        const id = row.slice(0, tab);
        const title = row.slice(tab + 1);
        titles.set(id, title || "");
      }
    }
  } catch {
    // ignore sqlite read issues
  }
}

function asNumber(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
}

for (const item of changed) {
  const abs = path.join(repoDir, item.relPath);
  let text = "";
  try {
    text = fs.readFileSync(abs, "utf8");
  } catch {
    continue;
  }
  if (!text) continue;

  const parsed = [];
  for (const line of text.split("\n")) {
    if (!line) continue;
    try {
      parsed.push(JSON.parse(line));
    } catch {
      // skip invalid line
    }
  }

  let sessionId = "";
  let model = "unknown";
  let latestTs = "";
  let maxTotal = 0;

  for (const evt of parsed) {
    if (!latestTs && evt?.timestamp) latestTs = String(evt.timestamp);
    if (evt?.timestamp && String(evt.timestamp) > latestTs) latestTs = String(evt.timestamp);
    if (!sessionId && evt?.type === "session_meta" && evt?.payload?.id) {
      sessionId = String(evt.payload.id);
    }
    if (evt?.type === "turn_context" && evt?.payload?.model) {
      model = String(evt.payload.model);
    }
    if (evt?.type === "event_msg" && evt?.payload?.type === "token_count") {
      const t = evt?.payload?.info?.total_token_usage;
      if (t && typeof t === "object") {
        maxTotal = Math.max(maxTotal, asNumber(t.total_tokens));
      }
    }
  }

  const shortId = sessionId ? sessionId.slice(0, 8) : "unknown";
  const fallbackTitle = `[untitled:${shortId}]`;
  const title = sessionId ? (titles.get(sessionId) || fallbackTitle) : fallbackTitle;
  const rolloutName = path.basename(item.relPath);

  process.stdout.write([
    item.status,
    rolloutName,
    sessionId || "unknown",
    title.replace(/\s+/g, " ").trim(),
    model,
    String(maxTotal),
    latestTs || "-",
  ].join("\t") + "\n");
}
NODE
  rm -f "$diff_file"
}

cmd_backup_status() {
  ensure_dirs
  local repo_dir
  repo_dir="$(backup_default_repo_dir)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      -h|--help)
        print_backup_help
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup status [--dir <path>]"
        ;;
    esac
  done

  local source_sessions backup_sessions
  source_sessions="$DEFAULT_HOME/sessions"
  backup_sessions="$repo_dir/sessions"

  local source_files backup_files
  source_files="$(count_jsonl_files "$source_sessions")"
  backup_files="$(count_jsonl_files "$backup_sessions")"

  local source_latest_epoch backup_latest_epoch runtime_latest_epoch
  local source_latest_human backup_latest_human runtime_latest_human
  source_latest_epoch="$(latest_mtime_epoch_for_pattern "$source_sessions" '*.jsonl')"
  backup_latest_epoch="$(latest_mtime_epoch_for_pattern "$backup_sessions" '*.jsonl')"
  runtime_latest_epoch="$(latest_runtime_epoch)"
  source_latest_human="$(format_epoch_local "$source_latest_epoch")"
  backup_latest_human="$(format_epoch_local "$backup_latest_epoch")"
  runtime_latest_human="$(format_epoch_local "$runtime_latest_epoch")"

  local runtime_unflushed_activity runtime_lag_seconds
  runtime_unflushed_activity="no"
  runtime_lag_seconds="0"
  if [ "$runtime_latest_epoch" -gt "$source_latest_epoch" ] 2>/dev/null; then
    runtime_unflushed_activity="yes"
    runtime_lag_seconds="$((runtime_latest_epoch - source_latest_epoch))"
  fi

  local source_ids backup_ids shared_ids coverage_pct
  source_ids="0"
  backup_ids="0"
  shared_ids="0"
  coverage_pct="0"
  if [ -d "$source_sessions" ]; then
    local coverage_tsv
    coverage_tsv="$(backup_session_id_coverage_tsv "$source_sessions" "$backup_sessions")"
    IFS=$'\t' read -r source_ids backup_ids shared_ids <<<"$coverage_tsv"
    source_ids="${source_ids:-0}"
    backup_ids="${backup_ids:-0}"
    shared_ids="${shared_ids:-0}"
    if [ "$source_ids" -gt 0 ] 2>/dev/null; then
      coverage_pct="$((shared_ids * 100 / source_ids))"
    fi
  fi

  local pending_copy pending_new pending_modified pending_delete
  pending_copy="0"
  pending_new="0"
  pending_modified="0"
  pending_delete="0"
  if [ -d "$source_sessions" ]; then
    local copy_tsv
    copy_tsv="$(backup_pending_copy_breakdown_tsv "$source_sessions" "$backup_sessions")"
    IFS=$'\t' read -r pending_copy pending_new pending_modified <<<"$copy_tsv"
    pending_copy="${pending_copy:-0}"
    pending_new="${pending_new:-0}"
    pending_modified="${pending_modified:-0}"
    pending_delete="$(backup_pending_delete_count "$source_sessions" "$backup_sessions")"
  fi

  local git_initialized branch remote_url last_commit
  git_initialized="no"
  branch="-"
  remote_url="-"
  last_commit="-"
  if [ -d "$repo_dir/.git" ]; then
    git_initialized="yes"
    branch="$(git -C "$repo_dir" branch --show-current 2>/dev/null || echo "-")"
    remote_url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || echo "-")"
    last_commit="$(git -C "$repo_dir" log -1 --format='%h %ci %s' 2>/dev/null || echo "-")"
  fi

  echo "--- backup status ---"
  echo "repo: $repo_dir"
  echo "git_initialized: $git_initialized"
  echo "branch: ${branch:-"-"}"
  echo "remote(origin): $remote_url"
  echo "last_commit: $last_commit"
  echo
  echo "sessions_source_files: $source_files"
  echo "sessions_backup_files: $backup_files"
  echo "session_ids_source: $source_ids"
  echo "session_ids_backup: $backup_ids"
  echo "session_id_coverage: ${coverage_pct}% ($shared_ids/$source_ids)"
  echo "sessions_source_latest_write: $source_latest_human"
  echo "sessions_backup_latest_write: $backup_latest_human"
  echo "codex_runtime_latest_write: $runtime_latest_human"
  echo "runtime_unflushed_activity: $runtime_unflushed_activity"
  echo "runtime_vs_sessions_lag_seconds: $runtime_lag_seconds"
  echo
  echo "pending_copy_files (default mode): $pending_copy"
  echo "pending_new_files (default mode): $pending_new"
  echo "pending_modified_files (default mode): $pending_modified"
  echo "pending_mirror_deletes (--delete mode): $pending_delete"
}

cmd_backup_init() {
  ensure_dirs
  local repo_dir
  repo_dir="$(backup_default_repo_dir)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      -h|--help)
        print_backup_help
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup init [--dir <path>]"
        ;;
    esac
  done

  ensure_backup_repo_initialized "$repo_dir"
  ensure_backup_gitignore "$repo_dir"

  echo "Backup repo ready: $repo_dir"
  echo "Tip: run 'dex backup --dir \"$repo_dir\"' to create the first snapshot commit."
}

cmd_backup_run() {
  ensure_dirs
  local repo_dir note delete_mode
  repo_dir="$(backup_default_repo_dir)"
  note=""
  delete_mode="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      --note)
        [ "$#" -ge 2 ] || die "Missing value for --note"
        note="$2"
        shift 2
        ;;
      --delete)
        delete_mode="true"
        shift
        ;;
      -h|--help)
        print_backup_help
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup [--note \"...\"] [--dir <path>] [--delete]"
        ;;
    esac
  done

  local source_sessions target_sessions
  source_sessions="$DEFAULT_HOME/sessions"
  target_sessions="$repo_dir/sessions"

  [ -d "$source_sessions" ] || die "No sessions directory found at $source_sessions"

  ensure_backup_repo_initialized "$repo_dir"
  ensure_backup_gitignore "$repo_dir"

  mkdir -p "$target_sessions"
  local before_count after_count
  before_count="$(count_jsonl_files "$target_sessions")"
  if [ "$delete_mode" = "true" ]; then
    rsync -a --delete "$source_sessions/" "$target_sessions/"
  else
    rsync -a "$source_sessions/" "$target_sessions/"
  fi
  after_count="$(count_jsonl_files "$target_sessions")"

  local summary_tsv sessions_counted total_tokens total_input total_cached total_output_wr models_used
  summary_tsv="$(backup_sessions_summary_tsv "$source_sessions")"
  IFS=$'\t' read -r sessions_counted total_tokens total_input total_cached total_output_wr models_used <<<"$summary_tsv"
  [ -n "$sessions_counted" ] || sessions_counted="0"
  [ -n "$total_tokens" ] || total_tokens="0"
  [ -n "$total_input" ] || total_input="0"
  [ -n "$total_cached" ] || total_cached="0"
  [ -n "$total_output_wr" ] || total_output_wr="0"
  [ -n "$models_used" ] || models_used="none"

  local tokens_human models_subject ts_human sync_mode commit_subject commit_body
  tokens_human="$(format_tokens_m "$total_tokens")"
  models_subject="$models_used"
  if [ "${#models_subject}" -gt 58 ]; then
    models_subject="${models_subject:0:55}..."
  fi
  ts_human="$(date -u +'%Y-%m-%d %H:%MZ')"
  if [ "$delete_mode" = "true" ]; then
    sync_mode="mirror (--delete)"
  else
    sync_mode="copy-only"
  fi

  commit_subject="backup: $ts_human | sessions=$sessions_counted | models=$models_subject | tokens=$tokens_human"
  commit_body="Backup details
source_sessions: $source_sessions
backup_repo: $repo_dir
sync_mode: $sync_mode
jsonl_files_before: $before_count
jsonl_files_after: $after_count

Usage snapshot
sessions_counted: $sessions_counted
models_used: $models_used
total_tokens: $total_tokens ($tokens_human)
input_tokens: $total_input
cached_tokens: $total_cached
output_tokens_with_reasoning: $total_output_wr"
  if [ -n "$note" ]; then
    commit_body="$commit_body

Note
$note"
  fi

  git -C "$repo_dir" add .gitignore sessions
  if git -C "$repo_dir" diff --cached --quiet; then
    echo "Backup synced ($sync_mode), but no file changes were detected. No commit created."
    return 0
  fi

  local session_notes_tsv session_notes_section notes_count
  session_notes_tsv="$(backup_session_notes_tsv "$repo_dir" || true)"
  session_notes_section=""
  notes_count=0
  if [ -n "$session_notes_tsv" ]; then
    session_notes_section="Session notes (new/changed rollouts since last backup)"
    while IFS=$'\t' read -r change rollout_name sid title model total_tokens latest_ts; do
      [ -n "$rollout_name" ] || continue
      notes_count=$((notes_count + 1))
      if [ "$notes_count" -gt 20 ]; then
        break
      fi
      session_notes_section="$session_notes_section
- [$change] $rollout_name | $title | model=$model | total_tokens=$total_tokens | latest_ts=$latest_ts"
    done <<< "$session_notes_tsv"
  fi

  if [ -n "$session_notes_section" ]; then
    commit_body="$commit_body

$session_notes_section"
  fi

  if ! git -C "$repo_dir" commit -m "$commit_subject" -m "$commit_body" >/dev/null; then
    die "Git commit failed in $repo_dir. Check git user.name/user.email configuration."
  fi

  echo "Backup commit created in $repo_dir"
  echo "Subject: $commit_subject"
}

cmd_backup_add_remote() {
  ensure_dirs
  local url="${1:-}"
  shift || true
  [ -n "$url" ] || die "Usage: dex backup add remote <url> [--name <remote>] [--dir <path>]"

  local repo_dir remote_name
  repo_dir="$(backup_default_repo_dir)"
  remote_name="origin"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        [ "$#" -ge 2 ] || die "Missing value for --name"
        remote_name="$2"
        shift 2
        ;;
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup add remote <url> [--name <remote>] [--dir <path>]"
        ;;
    esac
  done

  ensure_backup_repo_initialized "$repo_dir"
  ensure_backup_gitignore "$repo_dir"

  if git -C "$repo_dir" remote get-url "$remote_name" >/dev/null 2>&1; then
    git -C "$repo_dir" remote set-url "$remote_name" "$url"
    echo "Updated remote '$remote_name' -> $url"
  else
    git -C "$repo_dir" remote add "$remote_name" "$url"
    echo "Added remote '$remote_name' -> $url"
  fi
}

cmd_backup_push() {
  ensure_dirs
  local repo_dir remote_name branch
  repo_dir="$(backup_default_repo_dir)"
  remote_name="origin"
  branch=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      --remote)
        [ "$#" -ge 2 ] || die "Missing value for --remote"
        remote_name="$2"
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || die "Missing value for --branch"
        branch="$2"
        shift 2
        ;;
      -h|--help)
        print_backup_help
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup push [--remote <name>] [--branch <name>] [--dir <path>]"
        ;;
    esac
  done

  [ -d "$repo_dir/.git" ] || die "No git repo found at $repo_dir. Run: dex backup init [--dir <path>]"
  git -C "$repo_dir" rev-parse --verify HEAD >/dev/null 2>&1 || die "No commits found in $repo_dir. Run: dex backup first."
  git -C "$repo_dir" remote get-url "$remote_name" >/dev/null 2>&1 || die "Remote '$remote_name' is not configured in $repo_dir."

  local current_branch
  current_branch="$(git -C "$repo_dir" branch --show-current 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    branch="$current_branch"
  fi
  [ -n "$branch" ] || branch="main"

  if [ -n "$current_branch" ] && [ "$current_branch" != "$branch" ]; then
    if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_dir" checkout "$branch" >/dev/null
    else
      git -C "$repo_dir" checkout -b "$branch" >/dev/null
    fi
  fi

  git -C "$repo_dir" push -u "$remote_name" "$branch"
}

cmd_backup_restore() {
  ensure_dirs
  local repo_dir relaunch delete_mode force_mode
  repo_dir="$(backup_default_repo_dir)"
  relaunch="false"
  delete_mode="false"
  force_mode="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "Missing value for --dir"
        repo_dir="$2"
        shift 2
        ;;
      --relaunch)
        relaunch="true"
        shift
        ;;
      --delete)
        delete_mode="true"
        shift
        ;;
      --force)
        force_mode="true"
        shift
        ;;
      -h|--help)
        print_backup_help
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex backup restore [--dir <path>] [--relaunch] [--delete]"
        ;;
    esac
  done

  local source_sessions target_sessions
  source_sessions="$repo_dir/sessions"
  target_sessions="$DEFAULT_HOME/sessions"

  [ -d "$source_sessions" ] || die "No backup sessions found at $source_sessions"

  if is_codex_app_running; then
    if [ "$relaunch" = "true" ]; then
      echo "Codex App is running. Closing it before restore..."
      if ! close_codex_app_for_relaunch; then
        die "Could not close Codex App cleanly after retries."
      fi
    elif [ "$force_mode" != "true" ]; then
      die "Codex App is running. Close it first, or pass --relaunch (recommended) or --force."
    fi
  fi

  mkdir -p "$target_sessions"
  if [ "$delete_mode" = "true" ]; then
    rsync -a --delete "$source_sessions/" "$target_sessions/"
  else
    rsync -a "$source_sessions/" "$target_sessions/"
  fi

  if [ "$relaunch" = "true" ]; then
    if open_codex_app; then
      echo "Codex App relaunched after restore."
    else
      echo "Restore finished, but Codex App could not be opened automatically."
    fi
  fi

  echo "Restore completed from '$source_sessions' to '$target_sessions'."
}

cmd_backup() {
  local sub="${1:-run}"
  shift || true

  if [[ "$sub" == --* ]]; then
    set -- "$sub" "$@"
    sub="run"
  fi

  case "$sub" in
    run)
      cmd_backup_run "$@"
      ;;
    status)
      cmd_backup_status "$@"
      ;;
    init)
      cmd_backup_init "$@"
      ;;
    add)
      local target="${1:-}"
      shift || true
      if [ "$target" != "remote" ]; then
        die "Usage: dex backup add remote <url> [--name <remote>] [--dir <path>]"
      fi
      cmd_backup_add_remote "$@"
      ;;
    push)
      cmd_backup_push "$@"
      ;;
    restore)
      cmd_backup_restore "$@"
      ;;
    help|-h|--help)
      print_backup_help
      ;;
    *)
      die "Unknown backup subcommand '$sub'. Run: dex backup --help"
      ;;
  esac
}

