classify_usage_error_reason() {
  local raw="${1:-}"
  local err_lc
  err_lc="$(printf "%s" "$raw" | tr '[:upper:]' '[:lower:]')"

  if [[ "$err_lc" == *"not logged in"* ]] || [[ "$err_lc" == *"requiresopenaiauth"* ]] || [[ "$err_lc" == *"auth-expired"* ]] || [[ "$err_lc" == *"wham-http-401"* ]] || [[ "$err_lc" == *"wham-http-403"* ]]; then
    echo "not-logged"
  elif [[ "$err_lc" == *"error sending request for url"* ]] || [[ "$err_lc" == *"dns error"* ]] || [[ "$err_lc" == *"could not resolve host"* ]] || [[ "$err_lc" == *"connection refused"* ]] || [[ "$err_lc" == *"network is unreachable"* ]] || [[ "$err_lc" == *"connection reset"* ]]; then
    echo "network-error"
  elif [[ "$err_lc" == *"no rate limit snapshot"* ]] || [[ "$err_lc" == *"no-limits"* ]]; then
    echo "no-limits"
  elif [[ "$err_lc" == *"timeout"* ]]; then
    echo "timeout"
  else
    echo "rpc-error"
  fi
}

