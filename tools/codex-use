cmd_use() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: dex use <profile> [--force] [--relaunch] [--from-action]"
  validate_profile "$profile"
  ensure_dirs

  local force="false"
  local relaunch="false"
  local from_action="false"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force)
        force="true"
        ;;
      --relaunch|--restart-app)
        relaunch="true"
        ;;
      --from-action|--codex-action)
        from_action="true"
        ;;
      *)
        die "Unknown option '$1'. Usage: dex use <profile> [--force] [--relaunch] [--from-action]"
        ;;
    esac
    shift
  done

  local p_home src dst
  p_home="$(profile_home "$profile")"
  src="$(auth_file "$p_home")"
  dst="$(auth_file "$DEFAULT_HOME")"

  [ -f "$src" ] || die "Profile '$profile' has no auth.json. Run: dex login $profile"

  if is_codex_app_running; then
    if [ "$relaunch" = "true" ]; then
      echo "Codex App is running. Closing it before switch..."
      if ! close_codex_app_for_relaunch; then
        die "Could not close Codex App cleanly after retries. Close it manually and retry."
      fi
    elif [ "$force" != "true" ]; then
      die "Codex App is running. Close it first, or use 'dex use $profile --relaunch' (recommended) or '--force' if you accept in-flight risk."
    fi
  fi

  local backup_notice=""
  if [ -f "$dst" ]; then
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    local backup_path
    backup_path="$BACKUP_DIR/auth.$ts.json"
    cp "$dst" "$backup_path"
    chmod 600 "$backup_path" || true
    backup_notice="Backup created: $backup_path"
  fi

  cp "$src" "$dst"
  chmod 600 "$dst" || true

  echo "$(color_green "Default profile switched to '")$(color_green_bold "$profile")$(color_green "'.")"
  if [ -n "$backup_notice" ]; then
    echo "$backup_notice"
  fi
  echo
  echo "--- auth summary (default) ---"
  echo
  print_auth_summary_whoami "$dst"
  echo
  if [ "$relaunch" = "true" ]; then
    if open_codex_app; then
      echo "Codex App relaunched to pick up the new default auth."
      if [ "$from_action" = "true" ]; then
        if close_terminal_tab_for_current_tty; then
          exit 0
        else
          echo "Switched via Action mode, but could not auto-close this terminal tab."
        fi
      fi
    else
      echo "Switched auth, but failed to relaunch Codex App automatically. Open it manually."
    fi
  else
    echo "Tip: open/restart Codex App to ensure UI/session state reflects the new default account."
  fi
}

cmd_usage() {
  local command_mode="${1:-usage}"
  if [ "$command_mode" = "usage" ] || [ "$command_mode" = "limits" ]; then
    shift || true
  else
    command_mode="usage"
  fi

  if [ "$command_mode" = "limits" ] && [ "${1:-}" = "doctor" ]; then
    shift || true
    cmd_limits_doctor "$@"
    return $?
  fi

  ensure_dirs

  local profile="default"
  local json_mode="false"
  local refresh_mode="false"
  local live_only="false"
  local allow_cache="false"
  local backend_mode="auto"
  local all_mode="false"
  local profile_set="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        all_mode="true"
        ;;
      -a)
        all_mode="true"
        ;;
      --json)
        json_mode="true"
        ;;
      --refresh)
        refresh_mode="true"
        ;;
      --live-only)
        live_only="true"
        ;;
      --allow-cache)
        allow_cache="true"
        ;;
      --backend)
        shift
        backend_mode="${1:-}"
        [ -n "$backend_mode" ] || die "Missing value for --backend (allowed: auto, wham, rpc)"
        ;;
      default)
        profile="default"
        profile_set="true"
        ;;
      -h|--help)
        if [ "$command_mode" = "usage" ]; then
          echo "Usage: dex usage [--json]"
          echo "Examples:"
          echo "  dex usage"
          echo "  dex usage --json"
        else
          echo "Usage: dex limits [profile|default] [--all|-a] [--json] [--refresh] [--live-only] [--allow-cache] [--backend <auto|wham|rpc>]"
          echo "Examples:"
          echo "  dex limits"
          echo "  dex limits trabajo"
          echo "  dex limits default --json"
          echo "  dex limits --all"
          echo "  dex limits -a"
          echo "  dex limits --all --backend wham"
          echo "  dex limits --all --allow-cache"
          echo "  dex limits doctor --all"
        fi
        return 0
        ;;
      *)
        if [[ "$1" == --* ]]; then
          die "Unknown option '$1'"
        fi
        if [ "$profile_set" = "true" ]; then
          die "Only one profile argument is allowed."
        fi
        profile="$1"
        profile_set="true"
        ;;
    esac
    shift
  done

  if [ "$command_mode" = "usage" ]; then
    [ "$live_only" != "true" ] || die "--live-only only applies to 'limits'."
    [ "$allow_cache" != "true" ] || die "--allow-cache only applies to 'limits'."
    [ "$backend_mode" = "auto" ] || die "--backend only applies to 'limits'."
    if [ "$json_mode" = "true" ]; then
      historical_usage_json
      return 0
    fi

    print_historical_usage_table
    return 0
  fi

  backend_mode="$(normalize_backend_mode "$backend_mode" || true)"
  [ -n "$backend_mode" ] || die "Invalid --backend value. Allowed: auto, wham, rpc."
  if [ "$live_only" = "true" ] && [ "$allow_cache" = "true" ]; then
    die "Do not combine --live-only with --allow-cache."
  fi
  if [ "$json_mode" != "true" ] && [ "$live_only" != "true" ] && [ "$allow_cache" != "true" ]; then
    allow_cache="true"
  fi

  if [ "$all_mode" = "true" ]; then
    [ "$json_mode" != "true" ] || die "--all does not support --json yet."
    [ "$profile_set" != "true" ] || die "Do not pass profile/default with --all."

    local active_profile_for_default
    active_profile_for_default="$(normalized_active_profile)"
    print_current_default_profile_line "$active_profile_for_default"
    echo

    print_usage_table_header
    while IFS='|' read -r label target_home; do
      [ -n "$label" ] || continue
      if [ "$label" = "default" ]; then
        continue
      fi
      local mark_active="false"
      if [ -n "$active_profile_for_default" ] && [ "$label" = "$active_profile_for_default" ]; then
        mark_active="true"
      fi
      print_usage_table_row_for_home "$label" "$target_home" "$refresh_mode" "$mark_active" "$live_only" "$allow_cache" "$backend_mode"
    done < <(collect_usage_targets)
    print_usage_table_footer
    return 0
  fi

  local target_home label
  if [ "$profile" = "default" ]; then
    target_home="$DEFAULT_HOME"
    label="default"
  else
    validate_profile "$profile"
    target_home="$(profile_home "$profile")"
    [ -d "$target_home" ] || die "Profile '$profile' does not exist"
    label="$profile"
  fi

  [ -f "$(auth_file "$target_home")" ] || die "No auth.json found for '$label' at $target_home"

  if [ "$json_mode" != "true" ]; then
    local active_profile_for_default
    active_profile_for_default="$(normalized_active_profile)"
    print_current_default_profile_line "$active_profile_for_default"
    echo
    print_usage_table_header
    local mark_active="false"
    if [ "$label" != "default" ] && [ -n "$active_profile_for_default" ] && [ "$label" = "$active_profile_for_default" ]; then
      mark_active="true"
    fi
    print_usage_table_row_for_home "$label" "$target_home" "$refresh_mode" "$mark_active" "$live_only" "$allow_cache" "$backend_mode"
    print_usage_table_footer
    return 0
  fi

  local usage_json fetch_status
  fetch_status=0
  usage_json="$(fetch_usage_with_cache "$target_home" "$json_mode" "$refresh_mode" "$live_only" "$allow_cache" "$backend_mode")" || fetch_status=$?
  if [ "$fetch_status" -eq 0 ] || [ "$fetch_status" -eq 10 ]; then
    printf "%s" "$usage_json"
    return 0
  fi

  return "$fetch_status"
}

cmd_list() {
  ensure_dirs

  local default_auth default_account default_fp
  default_auth="$(auth_file "$DEFAULT_HOME")"
  default_account=""
  default_fp=""
  if [ -f "$default_auth" ]; then
    default_account="$(auth_account_id "$default_auth")"
    default_fp="$(auth_fingerprint "$default_auth")"
  fi

  echo "Default home: $(color_gray "$DEFAULT_HOME")"
  if [ -f "$default_auth" ]; then
    echo "Default account_id: ${default_account:-unknown}"
  else
    echo "Default account_id: (not logged in)"
  fi
  echo

  local found="false"
  for d in "$PROFILES_ROOT"/*; do
    [ -d "$d" ] || continue
    found="true"
    local name a
    name="$(basename "$d")"
    a="$(auth_file "$d")"

    local acc
    if [ -f "$a" ]; then
      acc="$(auth_account_id "$a")"
      local mark=" "
      local fp
      fp="$(auth_fingerprint "$a")"
      if [ -n "$default_fp" ] && [ -n "$fp" ] && [ "$fp" = "$default_fp" ]; then
        mark="*"
      elif [ -n "$default_account" ] && [ "$acc" = "$default_account" ]; then
        mark="~"
      fi
      echo "[$mark] $name"
      print_auth_summary "$a" | sed 's/^/    /'
    else
      echo "[ ] $name"
      echo "    auth: missing"
    fi
    echo
  done

  if [ "$found" = "false" ]; then
    echo "No profiles yet. Create one with: dex login <profile>"
  fi

  echo "Legend: '*' means exact same auth token as current default ~/.codex/auth.json"
  echo "        '~' means same account_id but different token/identity"
}

cmd_whoami() {
  ensure_dirs
  local d_auth active_profile
  d_auth="$(auth_file "$DEFAULT_HOME")"
  active_profile="$(detect_active_profile)"
  print_login_status_for_home "$DEFAULT_HOME"
  echo "$(color_green "Active profile: ")$(color_green_bold "$active_profile")"
  echo "Default home: $(color_gray "$DEFAULT_HOME")"
  echo
  echo "--- auth summary (default) ---"
  echo
  print_auth_summary_whoami "$d_auth"
}

cmd_status() {
  local profile="${1:-}"
  shift || true
  [ -n "$profile" ] || die "Usage: dex status <profile> [--refresh] [--live-only] [--allow-cache] [--backend <auto|wham|rpc>]"
  validate_profile "$profile"

  local refresh_mode="false"
  local live_only="false"
  local allow_cache="false"
  local backend_mode="auto"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --refresh)
        refresh_mode="true"
        ;;
      --live-only)
        live_only="true"
        ;;
      --allow-cache)
        allow_cache="true"
        ;;
      --backend)
        shift
        backend_mode="${1:-}"
        [ -n "$backend_mode" ] || die "Missing value for --backend (allowed: auto, wham, rpc)"
        ;;
      *)
        die "Unknown option '$1'. Usage: dex status <profile> [--refresh] [--live-only] [--allow-cache] [--backend <auto|wham|rpc>]"
        ;;
    esac
    shift
  done

  backend_mode="$(normalize_backend_mode "$backend_mode" || true)"
  [ -n "$backend_mode" ] || die "Invalid --backend value. Allowed: auto, wham, rpc."
  if [ "$live_only" = "true" ] && [ "$allow_cache" = "true" ]; then
    die "Do not combine --live-only with --allow-cache."
  fi

  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"
  local p_auth
  p_auth="$(auth_file "$p_home")"
  [ -f "$p_auth" ] || die "No auth.json found for '$profile' at $p_home"

  print_login_status_for_home "$p_home"
  echo "$(color_green "Profile: ")$(color_green_bold "$profile")"
  echo "Profile home: $(color_gray "$p_home")"
  echo
  echo "--- auth summary ($profile) ---"
  echo
  print_auth_summary_whoami "$p_auth"
  echo
  print_usage_details_for_home "$p_home" "$refresh_mode" "$live_only" "$allow_cache" "$backend_mode"
}

cmd_logout() {
  local profile="${1:-}"
  [ -n "$profile" ] || die "Usage: dex logout <profile>"
  validate_profile "$profile"
  local p_home
  p_home="$(profile_home "$profile")"
  [ -d "$p_home" ] || die "Profile '$profile' does not exist"
  CODEX_HOME="$p_home" run_codex logout
  echo "Logged out profile '$profile'"
}

cmd_logout_default() {
  ensure_dirs
  CODEX_HOME="$DEFAULT_HOME" run_codex logout
  echo "Logged out default profile ($DEFAULT_HOME)"
}

cmd_add() {
  local subject="${1:-}"
  local target="${2:-}"
  shift 2 || true

  if [ "$subject" != "switch" ] || [ "$target" != "action" ]; then
    die "Usage: dex add switch action [--platform <macos|darwin>] [--icon <icon>] [--command-name <dex|cdex|codex-use>] [--dry-run]"
  fi

  ensure_dirs

  local platform_input="macos"
  local icon="test"
  local command_name="dex"
  local dry_run="false"
  local project_dir="$PWD"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --platform)
        [ "$#" -ge 2 ] || die "Missing value for --platform"
        platform_input="$2"
        shift 2
        ;;
      --icon)
        [ "$#" -ge 2 ] || die "Missing value for --icon"
        icon="$2"
        shift 2
        ;;
      --command-name)
        [ "$#" -ge 2 ] || die "Missing value for --command-name"
        command_name="$2"
        shift 2
        ;;
      --project-dir)
        [ "$#" -ge 2 ] || die "Missing value for --project-dir"
        project_dir="$2"
        shift 2
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      -h|--help)
        echo "Usage: dex add switch action [--platform <macos|darwin>] [--icon <icon>] [--command-name <dex|cdex|codex-use>] [--project-dir <dir>] [--dry-run]"
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex add switch action [--platform <macos|darwin>] [--icon <icon>] [--command-name <dex|cdex|codex-use>] [--dry-run]"
        ;;
    esac
  done

  [[ "$command_name" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Invalid --command-name '$command_name'."
  [[ "$icon" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid --icon '$icon'."

  local platform
  platform="$(normalize_actions_platform "$platform_input")"

  local profiles=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    profiles+=("$p")
  done < <(collect_profiles_with_auth)

  [ "${#profiles[@]}" -gt 0 ] || die "No profiles with auth.json found in $PROFILES_ROOT. Run: dex login <profile>"

  local profiles_csv
  profiles_csv="$(IFS=,; echo "${profiles[*]}")"

  project_dir="$(cd "$project_dir" && pwd)"
  local env_file project_name new_content
  env_file="$project_dir/.codex/environments/environment.toml"
  project_name="$(basename "$project_dir")"

  new_content="$(render_environment_with_switch_actions "$env_file" "$project_name" "$platform" "$icon" "$command_name" "$profiles_csv")"

  if [ "$dry_run" = "true" ]; then
    if [ -f "$env_file" ]; then
      diff -u "$env_file" <(printf '%s' "$new_content") || true
    else
      printf '%s\n' "$new_content"
    fi
    echo
    echo "Dry run only. No files were written."
    return 0
  fi

  mkdir -p "$(dirname "$env_file")"
  printf '%s' "$new_content" > "$env_file"

  echo "Updated actions file: $env_file"
  echo "Platform: $platform"
  echo "Command name: $command_name"
  echo "Added/updated switch actions:"
  local p
  for p in "${profiles[@]}"; do
    echo "  - switch $p"
  done
}

cmd_delete() {
  local subject="${1:-}"
  local target="${2:-}"
  shift 2 || true

  if [ "$subject" != "switch" ] || [ "$target" != "action" ]; then
    die "Usage: dex delete switch action [--platform <macos|darwin>] [--project-dir <dir>] [--dry-run]"
  fi

  local platform_input="macos"
  local dry_run="false"
  local project_dir="$PWD"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --platform)
        [ "$#" -ge 2 ] || die "Missing value for --platform"
        platform_input="$2"
        shift 2
        ;;
      --project-dir)
        [ "$#" -ge 2 ] || die "Missing value for --project-dir"
        project_dir="$2"
        shift 2
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      -h|--help)
        echo "Usage: dex delete switch action [--platform <macos|darwin>] [--project-dir <dir>] [--dry-run]"
        return 0
        ;;
      *)
        die "Unknown option '$1'. Usage: dex delete switch action [--platform <macos|darwin>] [--dry-run]"
        ;;
    esac
  done

  local platform
  platform="$(normalize_actions_platform "$platform_input")"

  project_dir="$(cd "$project_dir" && pwd)"
  local env_file new_content before_count after_count removed
  env_file="$project_dir/.codex/environments/environment.toml"

  [ -f "$env_file" ] || die "No actions file found at $env_file"

  before_count="$(count_switch_actions_for_platform "$env_file" "$platform")"
  new_content="$(render_environment_without_switch_actions "$env_file" "$platform")"
  after_count="$(count_switch_actions_for_platform <(printf '%s' "$new_content") "$platform")"
  removed=$((before_count - after_count))
  [ "$removed" -ge 0 ] || removed=0

  if [ "$dry_run" = "true" ]; then
    diff -u "$env_file" <(printf '%s' "$new_content") || true
    echo
    echo "Dry run only. No files were written."
    echo "Switch actions removed for platform '$platform': $removed"
    return 0
  fi

  printf '%s' "$new_content" > "$env_file"
  echo "Updated actions file: $env_file"
  echo "Platform: $platform"
  echo "Switch actions removed: $removed"
}

main() {
  resolve_codex_bin

  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    login) cmd_login "$@" ;;
    use) cmd_use "$@" ;;
    usage) cmd_usage usage "$@" ;;
    limits) cmd_usage limits "$@" ;;
    backup) cmd_backup "$@" ;;
    pricing) cmd_pricing "$@" ;;
    list) cmd_list ;;
    whoami) cmd_whoami ;;
    status) cmd_status "$@" ;;
    logout) cmd_logout "$@" ;;
    logout-default) cmd_logout_default ;;
    add) cmd_add "$@" ;;
    delete) cmd_delete "$@" ;;
    help|-h|--help) usage ;;
    *) die "Unknown command '$cmd'. Run: dex help" ;;
  esac
}

main "$@"
