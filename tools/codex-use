print_historical_usage_table() {
  local usage_json usage_rows total_io_m pricing_path
  pricing_path="$(pricing_file)"
  usage_json="$(historical_usage_json)"
  usage_rows="$(printf "%s" "$usage_json" | historical_usage_to_tsv "$pricing_path" 2>/dev/null || true)"
  total_io_m="$(printf "%s" "$usage_json" | historical_usage_total_io_m 2>/dev/null || true)"

  if [ -z "$usage_rows" ]; then
    echo "No historical usage data found."
    return 0
  fi

  print_historical_usage_table_header
  local total_sessions="" total_input="" total_output="" total_cache=""
  local total_cost_input="" total_cost_output="" total_cost_cache="" total_cost_all=""
  while IFS=$'\t' read -r model sessions input_m output_m cache_m cost_in cost_out cost_cache cost_total _discard_cost_inout; do
    [ -n "$model" ] || continue
    if [ "$model" = "TOTAL" ]; then
      total_sessions="$sessions"
      total_input="$input_m"
      total_output="$output_m"
      total_cache="$cache_m"
      total_cost_input="$cost_in"
      total_cost_output="$cost_out"
      total_cost_cache="$cost_cache"
      total_cost_all="$cost_total"
      continue
    fi
    print_historical_usage_table_row "$model" "$sessions" "$input_m" "$output_m" "$cache_m"
    print_historical_usage_table_row "" "" "$cost_in" "$cost_out" "$cost_cache"
    print_historical_usage_table_blank_row
  done <<< "$usage_rows"

  if [ -n "$total_sessions" ]; then
    print_historical_usage_table_footer
    print_historical_usage_table_row "" "$total_sessions" "$total_input" "$total_output" "$total_cache"
    print_historical_usage_table_row "" "" "$total_cost_input" "$total_cost_output" "$total_cost_cache"
  fi
  print_historical_usage_table_footer
  if [ -n "$total_cache" ]; then
    print_historical_usage_token_summary_row "Total Token Usage" "${total_io_m:-"-"}" "$total_cache"
    print_historical_usage_token_summary_row "Total Token Cost" "${total_cost_all:-"-"}" ""
  fi
  echo "Cost formula: in_cost uses non-cached input tokens (in - cache)."
  echo "Note: out(M) includes reasoning output."
}

