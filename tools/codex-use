  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(" ");
  return deltaMs >= 0 ? `${relative} ago` : `in ${relative}`;
}

const row = [stale, relativeAge(fetchedAt)];
process.stdout.write(row.join("\t"));
'
}

json_usage_details_to_tsv() {
  node -e '
const fs = require("fs");
const raw = fs.readFileSync(0, "utf8");
const data = JSON.parse(raw);
const r = data?.rateLimits || {};
const p = r?.primary || null;
const s = r?.secondary || null;
const credits = r?.credits || null;

function label(minutes, fallback) {
  if (minutes === 300) return "5h";
  if (minutes === 10080) return "weekly";
  if (typeof minutes === "number") return `${minutes}m`;
  return fallback;
}

function used(value) {
  return (typeof value === "number") ? `${Math.max(0, Math.min(100, value))}%` : "-";
}

function remaining(value) {
  return (typeof value === "number") ? `${Math.max(0, 100 - value)}%` : "-";
}

function resetRelative(epochSeconds) {
  if (epochSeconds == null) return "unknown";
  const nowMs = Date.now();
  const targetMs = epochSeconds * 1000;
  const deltaMs = targetMs - nowMs;
  const absMs = Math.abs(deltaMs);
  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(" ");
  return deltaMs >= 0 ? `in ${relative}` : `${relative} ago`;
}

const pRel = resetRelative(p?.resetsAt);
const sRel = resetRelative(s?.resetsAt);

const row = [
  label(p?.windowDurationMins, "primary"),
  remaining(p?.usedPercent),
  pRel,
  label(s?.windowDurationMins, "secondary"),
  remaining(s?.usedPercent),
  sRel,
  credits ? String(credits.hasCredits) : "-",
  credits ? String(credits.unlimited) : "-",
  credits && credits.balance != null ? String(credits.balance) : "null",
];

process.stdout.write(row.join("\t"));
'
}

print_usage_details_for_home() {
  local target_home="$1"
  local refresh_mode="${2:-false}"
  local live_only="${3:-false}"
  local allow_cache="${4:-false}"
  local backend_mode="${5:-auto}"

  local rpc_json err_file fetch_status
  err_file="$(mktemp)"
  if rpc_json="$(fetch_usage_with_cache "$target_home" "true" "$refresh_mode" "$live_only" "$allow_cache" "$backend_mode" 2>"$err_file")"; then
    fetch_status=0
  else
    fetch_status=$?
  fi

  if [ "$fetch_status" -eq 0 ] || [ "$fetch_status" -eq 10 ]; then
    local tsv
    if tsv="$(printf "%s" "$rpc_json" | json_usage_details_to_tsv 2>/dev/null)"; then
      local p_label p_left p_rel s_label s_left s_rel c_has c_unlimited c_balance
      IFS=$'\t' read -r p_label p_left p_rel s_label s_left s_rel c_has c_unlimited c_balance <<<"$tsv"
      local p_bar s_bar p_hint s_hint credits_line
      p_bar="$(render_percent_bar "$p_left")"
      s_bar="$(render_percent_bar "$s_left")"
      p_hint="$(renewal_hint_text "$p_rel")"
      s_hint="$(renewal_hint_text "$s_rel")"
      credits_line="$(format_credits_line "$c_has" "$c_unlimited" "$c_balance")"

      echo "--- usage & limits ---"
      echo
      if [ "$fetch_status" -eq 10 ]; then
        local cache_tsv stale_flag stale_age
        if cache_tsv="$(printf "%s" "$rpc_json" | json_cache_info_to_tsv 2>/dev/null)"; then
          IFS=$'\t' read -r stale_flag stale_age <<<"$cache_tsv"
          if [ "$stale_flag" = "true" ]; then
            echo "note: showing cached limits snapshot (${stale_age:-unknown})"
            echo
          fi
        else
          echo "note: showing cached limits snapshot"
          echo
        fi
      fi
      echo "$p_label remaining: $(color_cyan "$p_left") $(color_cyan "$p_bar") ($(color_gray "$p_hint"))"
      echo "$s_label remaining: $(color_cyan "$s_left") $(color_cyan "$s_bar") ($(color_gray "$s_hint"))"
      echo "$credits_line"
    else
      echo "--- usage & limits ---"
      echo
      echo "usage unavailable: parse-error"
    fi
  else
    local rpc_err reason
    rpc_err="$(cat "$err_file")"
    rpc_err="$(echo "$rpc_err" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    reason="$(classify_usage_error_reason "$rpc_err")"

    echo "--- usage & limits ---"
    echo
    echo "usage unavailable: $reason"
  fi
  rm -f "$err_file"
}

crop_cell() {
  local text="$1"
  local width="$2"
  if [ "${#text}" -le "$width" ]; then
    printf "%s" "$text"
    return 0
  fi
  if [ "$width" -le 3 ]; then
    printf "%s" "${text:0:$width}"
    return 0
  fi
  printf "%s..." "${text:0:$((width-3))}"
}

