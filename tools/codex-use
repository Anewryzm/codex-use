render_environment_with_switch_actions() {
  local env_file="$1"
  local project_name="$2"
  local platform="$3"
  local icon="$4"
  local command_name="$5"
  local profiles_csv="$6"

  node - "$env_file" "$project_name" "$platform" "$icon" "$command_name" "$profiles_csv" <<'NODE'
const fs = require("fs");
const path = require("path");

const envFile = process.argv[2];
const projectName = process.argv[3] || "project";
const platform = process.argv[4] || "darwin";
const icon = process.argv[5] || "test";
const commandName = process.argv[6] || "dex";
const profilesCsv = process.argv[7] || "";
const profiles = profilesCsv.split(",").filter(Boolean);

function tomlEscape(v) {
  return String(v).replace(/\\/g, "\\\\").replace(/"/g, '\\"');
}

function defaultPrefix(name) {
  return [
    "# THIS IS AUTOGENERATED. DO NOT EDIT MANUALLY",
    "version = 1",
    `name = "${tomlEscape(name)}"`,
    "",
    "[setup]",
    'script = ""',
    "",
  ].join("\n");
}

let existing = "";
try {
  existing = fs.readFileSync(envFile, "utf8");
} catch {
  existing = "";
}

const actionStarts = [];
{
  const lines = existing.split(/\r?\n/);
  let offset = 0;
  for (const line of lines) {
    if (line.trim() === "[[actions]]") {
      actionStarts.push(offset);
    }
    offset += line.length + 1;
  }
}

let prefix = existing;
let blocks = [];
if (actionStarts.length > 0) {
  prefix = existing.slice(0, actionStarts[0]);
  for (let i = 0; i < actionStarts.length; i++) {
    const start = actionStarts[i];
    const end = i + 1 < actionStarts.length ? actionStarts[i + 1] : existing.length;
    blocks.push(existing.slice(start, end).trim());
  }
}

if (!prefix.trim()) {
  prefix = defaultPrefix(path.basename(projectName));
}

const targetNames = new Set(profiles.map((p) => `switch ${p}`));
const keepBlocks = blocks.filter((block) => {
  const nameMatch = block.match(/^name\s*=\s*"([^"]*)"/m);
  const platformMatch = block.match(/^platform\s*=\s*"([^"]*)"/m);
  if (!nameMatch || !platformMatch) return true;
  const name = nameMatch[1];
  const p = platformMatch[1];
  // Replace only this feature's managed switch actions for the same platform.
  if (p === platform && targetNames.has(name)) return false;
  return true;
});

const generatedBlocks = profiles.map((profile) => {
  const cmd = `osascript -e "tell application \\"Terminal\\" to activate" -e "tell application \\"Terminal\\" to do script \\"zsh -ic '${commandName} use ${profile} --relaunch --from-action; exit'\\""`;
  return [
    "[[actions]]",
    `name = "${tomlEscape(`switch ${profile}`)}"`,
    `icon = "${tomlEscape(icon)}"`,
    `command = "${tomlEscape(cmd)}"`,
    `platform = "${tomlEscape(platform)}"`,
  ].join("\n");
});

let out = prefix.trimEnd() + "\n\n";
const finalBlocks = [...keepBlocks, ...generatedBlocks];
if (finalBlocks.length > 0) {
  out += finalBlocks.join("\n\n") + "\n";
}

process.stdout.write(out);
NODE
}

