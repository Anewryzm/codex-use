function windowLabel(minutes) {
  if (minutes === 300) return '5h';
  if (minutes === 10080) return 'weekly';
  if (typeof minutes === 'number') return `${minutes}m`;
  return 'window';
}

function resetText(epochSeconds) {
  if (epochSeconds == null) return 'unknown';
  const nowMs = Date.now();
  const targetMs = epochSeconds * 1000;
  const deltaMs = targetMs - nowMs;
  const absMs = Math.abs(deltaMs);
  const mins = Math.floor(absMs / 60000);
  const days = Math.floor(mins / (60 * 24));
  const hours = Math.floor((mins % (60 * 24)) / 60);
  const minutes = mins % 60;
  const parts = [];
  if (days > 0) parts.push(`${days}d`);
  if (hours > 0) parts.push(`${hours}h`);
  if (minutes > 0 || parts.length === 0) parts.push(`${minutes}m`);
  const relative = parts.slice(0, 2).join(' ');
  return deltaMs >= 0 ? `in ${relative}` : `${relative} ago`;
}

