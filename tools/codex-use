now_epoch_ms() {
  node -e 'process.stdout.write(String(Date.now()))'
}

probe_live_backend_for_home() {
  local source="$1"
  local target_home="$2"
  local refresh_mode="$3"

  local start_ms end_ms elapsed_ms err_file out rc err reason
  start_ms="$(now_epoch_ms)"
  err_file="$(mktemp)"
  if [ "$source" = "wham" ]; then
    if out="$(fetch_usage_via_wham "$target_home" 2>"$err_file")"; then
      rc=0
    else
      rc=$?
    fi
  else
    if out="$(fetch_usage_via_rpc "$target_home" "true" "$refresh_mode" 2>"$err_file")"; then
      rc=0
    else
      rc=$?
    fi
  fi
  end_ms="$(now_epoch_ms)"
  elapsed_ms="$((end_ms - start_ms))"

  if [ "$rc" -eq 0 ]; then
    local tsv email p_left p_reset s_left s_reset
    if tsv="$(printf "%s" "$out" | json_usage_to_tsv 2>/dev/null)"; then
      IFS=$'\t' read -r email _plan p_left p_reset s_left s_reset <<<"$tsv"
    else
      email="-"
      p_left="-"
      p_reset="-"
      s_left="-"
      s_reset="-"
    fi
    printf 'ok\t%s\t-\t%s\t%s\t%s\t%s\t%s\n' "$elapsed_ms" "$email" "$p_left" "$p_reset" "$s_left" "$s_reset"
    rm -f "$err_file"
    return 0
  fi

  err="$(cat "$err_file" 2>/dev/null || true)"
  rm -f "$err_file"
  reason="$(classify_usage_error_reason "$err")"
  printf 'error\t%s\t%s\t-\t-\t-\t-\t-\n' "$elapsed_ms" "$reason"
  return 1
}

print_limits_doctor_for_home() {
  local label="$1"
  local target_home="$2"
  local refresh_mode="$3"
  local allow_cache="$4"
  local backend_mode="$5"

  local auth_path
  auth_path="$(auth_file "$target_home")"
  echo "[$label]"
  if [ ! -f "$auth_path" ]; then
    echo "  auth: missing ($auth_path)"
    echo
    return 0
  fi
  echo "  auth: ok ($auth_path)"

  local wham_tsv rpc_tsv
  wham_tsv="$(probe_live_backend_for_home "wham" "$target_home" "$refresh_mode")" || true
  rpc_tsv="$(probe_live_backend_for_home "rpc" "$target_home" "$refresh_mode")" || true

  local wham_state wham_ms wham_reason wham_email wham_5h wham_5h_reset wham_weekly wham_weekly_reset
  local rpc_state rpc_ms rpc_reason rpc_email rpc_5h rpc_5h_reset rpc_weekly rpc_weekly_reset
  IFS=$'\t' read -r wham_state wham_ms wham_reason wham_email wham_5h wham_5h_reset wham_weekly wham_weekly_reset <<<"$wham_tsv"
  IFS=$'\t' read -r rpc_state rpc_ms rpc_reason rpc_email rpc_5h rpc_5h_reset rpc_weekly rpc_weekly_reset <<<"$rpc_tsv"

  if [ "$wham_state" = "ok" ]; then
    echo "  wham: ok (${wham_ms}ms) email=${wham_email} 5h=${wham_5h} (${wham_5h_reset}) weekly=${wham_weekly} (${wham_weekly_reset})"
  else
    echo "  wham: error (${wham_ms}ms) reason=${wham_reason}"
  fi

  if [ "$rpc_state" = "ok" ]; then
    echo "  rpc:  ok (${rpc_ms}ms) email=${rpc_email} 5h=${rpc_5h} (${rpc_5h_reset}) weekly=${rpc_weekly} (${rpc_weekly_reset})"
  else
    echo "  rpc:  error (${rpc_ms}ms) reason=${rpc_reason}"
  fi

  local resolved_backend
  case "$backend_mode" in
    wham)
      if [ "$wham_state" = "ok" ]; then resolved_backend="wham"; else resolved_backend="error"; fi
      ;;
    rpc)
      if [ "$rpc_state" = "ok" ]; then resolved_backend="rpc"; else resolved_backend="error"; fi
      ;;
    auto|*)
      if [ "$wham_state" = "ok" ]; then
        resolved_backend="wham"
      elif [ "$rpc_state" = "ok" ]; then
        resolved_backend="rpc"
      else
        resolved_backend="error"
      fi
      ;;
  esac

  local cache_file cache_info
  cache_file="$(limits_cache_file "$target_home")"
  if [ -f "$cache_file" ]; then
    cache_info="$(node -e '
const fs = require("fs");
const p = process.argv[1];
let j = {};
try { j = JSON.parse(fs.readFileSync(p, "utf8")); } catch {}
const m = j?._codexUseCache || {};
const fetchedAt = Number(m.fetchedAt);
const source = m.source || "unknown";
if (!Number.isFinite(fetchedAt) || fetchedAt <= 0) {
  process.stdout.write(`${source}\tunknown`);
} else {
  const ageSecs = Math.max(0, Math.floor(Date.now() / 1000) - Math.floor(fetchedAt));
  process.stdout.write(`${source}\t${ageSecs}s`);
}
' "$cache_file" 2>/dev/null || true)"
    local cache_source cache_age
    IFS=$'\t' read -r cache_source cache_age <<<"$cache_info"
    echo "  cache: present source=${cache_source:-unknown} age=${cache_age:-unknown}"
  else
    echo "  cache: missing"
  fi

  echo "  selected-backend(mode=${backend_mode}): ${resolved_backend}"
  echo "  allow-cache: ${allow_cache}"
  echo
}

cmd_limits_doctor() {
  ensure_dirs

  local refresh_mode="false"
  local allow_cache="false"
  local backend_mode="auto"
  local all_mode="false"
  local profile=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --refresh)
        refresh_mode="true"
        ;;
      --allow-cache)
        allow_cache="true"
        ;;
      --backend)
        shift
        backend_mode="${1:-}"
        [ -n "$backend_mode" ] || die "Missing value for --backend (allowed: auto, wham, rpc)"
        ;;
      --all|-a)
        all_mode="true"
        ;;
      -h|--help)
        echo "Usage: dex limits doctor [profile|--all] [--refresh] [--allow-cache] [--backend <auto|wham|rpc>]"
        echo "Examples:"
        echo "  dex limits doctor"
        echo "  dex limits doctor personal"
        echo "  dex limits doctor --all --backend auto"
        return 0
        ;;
      *)
        if [[ "$1" == --* ]]; then
          die "Unknown option '$1'. Usage: dex limits doctor [profile|--all] [--refresh] [--allow-cache] [--backend <auto|wham|rpc>]"
        fi
        if [ -n "$profile" ]; then
          die "Only one profile argument is allowed for limits doctor."
        fi
        profile="$1"
        ;;
    esac
    shift
  done

  backend_mode="$(normalize_backend_mode "$backend_mode" || true)"
  [ -n "$backend_mode" ] || die "Invalid --backend value. Allowed: auto, wham, rpc."

  if [ "$all_mode" = "true" ] && [ -n "$profile" ]; then
    die "Do not pass a profile with --all."
  fi

  if [ -n "$profile" ]; then
    if [ "$profile" = "default" ]; then
      print_limits_doctor_for_home "default" "$DEFAULT_HOME" "$refresh_mode" "$allow_cache" "$backend_mode"
      return 0
    fi
    validate_profile "$profile"
    local p_home
    p_home="$(profile_home "$profile")"
    [ -d "$p_home" ] || die "Profile '$profile' does not exist"
    print_limits_doctor_for_home "$profile" "$p_home" "$refresh_mode" "$allow_cache" "$backend_mode"
    return 0
  fi

  print_current_default_profile_line "$(normalized_active_profile)"
  echo
  while IFS='|' read -r label target_home; do
    [ -n "$label" ] || continue
    if [ "$label" = "default" ]; then
      continue
    fi
    print_limits_doctor_for_home "$label" "$target_home" "$refresh_mode" "$allow_cache" "$backend_mode"
  done < <(collect_usage_targets)
}

historical_usage_json() {
  local sessions_root="$HOME/.codex/sessions"
  node - "$sessions_root" <<'NODE'
const fs = require('fs');
const path = require('path');

const sessionsRoot = process.argv[2];

function walkJsonlFiles(dir, out = []) {
  if (!fs.existsSync(dir)) return out;
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walkJsonlFiles(p, out);
    else if (e.isFile() && p.endsWith('.jsonl')) out.push(p);
  }
  return out;
}

function asNumber(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
}

const files = walkJsonlFiles(sessionsRoot).sort();
// Some sessions can be split across multiple files with the same session id.
// Keep only the file with the highest observed total_tokens per session id.
const selectedFilesBySession = new Map();
for (const file of files) {
  let content = '';
  try {
    content = fs.readFileSync(file, 'utf8');
  } catch {
    continue;
  }
  if (!content) continue;
  const lines = content.split('\n');
  let sessionId = null;
  let maxTotalInFile = 0;
  for (const line of lines) {
    if (!line) continue;
    let event;
    try {
      event = JSON.parse(line);
    } catch {
      continue;
    }
    if (event.type === 'session_meta' && !sessionId) {
      // A rollout file can include replayed history with older session_meta entries.
      // Keep the first session id (owner of the file), not later replayed ones.
      sessionId = event?.payload?.id || sessionId;
    }
    if (event.type === 'event_msg' && event?.payload?.type === 'token_count') {
      const t = event?.payload?.info?.total_token_usage;
      if (!t || typeof t !== 'object') continue;
      maxTotalInFile = Math.max(maxTotalInFile, asNumber(t.total_tokens));
    }
  }
  const key = sessionId || file;
  const prev = selectedFilesBySession.get(key);
  if (!prev || maxTotalInFile >= prev.maxTotalInFile) {
    selectedFilesBySession.set(key, { file, maxTotalInFile });
  }
}

const totals = {
  input: 0,
  cached: 0,
  output: 0,
  reasoning: 0,
  outputWithReasoning: 0,
  total: 0,
  sessions: 0,
};

const byModel = new Map();
for (const { file } of selectedFilesBySession.values()) {
  let content = '';
  try {
    content = fs.readFileSync(file, 'utf8');
  } catch {
    continue;
  }
  if (!content) continue;
  const lines = content.split('\n');

  let currentModel = 'unknown';
  let seenAnySnapshot = false;
  let prev = {
    input: 0,
    cached: 0,
    output: 0,
    reasoning: 0,
    total: 0,
  };

  for (const line of lines) {
    if (!line) continue;
    let event;
    try {
      event = JSON.parse(line);
    } catch {
      continue;
    }

    if (event.type === 'turn_context' && event?.payload?.model) {
      currentModel = event.payload.model;
      continue;
    }

    if (event.type !== 'event_msg' || event?.payload?.type !== 'token_count') {
      continue;
    }

    const t = event?.payload?.info?.total_token_usage;
    if (!t || typeof t !== 'object') continue;
    seenAnySnapshot = true;

    const cur = {
      input: asNumber(t.input_tokens),
      cached: asNumber(t.cached_input_tokens),
      output: asNumber(t.output_tokens),
      reasoning: asNumber(t.reasoning_output_tokens),
      total: asNumber(t.total_tokens),
    };

    const delta = {
      input: Math.max(0, cur.input - prev.input),
      cached: Math.max(0, cur.cached - prev.cached),
      output: Math.max(0, cur.output - prev.output),
      reasoning: Math.max(0, cur.reasoning - prev.reasoning),
      total: Math.max(0, cur.total - prev.total),
    };

    totals.input += delta.input;
    totals.cached += delta.cached;
    totals.output += delta.output;
    totals.reasoning += delta.reasoning;
    totals.total += delta.total;
    totals.outputWithReasoning += (delta.output + delta.reasoning);

    const key = currentModel || 'unknown';
    const m = byModel.get(key) || {
      model: key,
      sessions: 0,
      input: 0,
      cached: 0,
      output: 0,
      reasoning: 0,
      outputWithReasoning: 0,
      total: 0,
    };
    m.input += delta.input;
    m.cached += delta.cached;
    m.output += delta.output;
    m.reasoning += delta.reasoning;
    m.outputWithReasoning += (delta.output + delta.reasoning);
    m.total += delta.total;
    byModel.set(key, m);

    prev = cur;
  }

  if (seenAnySnapshot) {
    totals.sessions += 1;
    const seenModelsInSession = new Set();
    for (const line of lines) {
      if (!line) continue;
      let event;
      try {
        event = JSON.parse(line);
      } catch {
        continue;
      }
      if (event.type === 'turn_context' && event?.payload?.model) {
        seenModelsInSession.add(event.payload.model);
      }
    }
    if (seenModelsInSession.size === 0) {
      seenModelsInSession.add('unknown');
    }
    for (const model of seenModelsInSession) {
      const m = byModel.get(model);
      if (m) m.sessions += 1;
    }
  }
}

const models = Array.from(byModel.values()).sort((a, b) => b.total - a.total);

const out = {
  source: 'local-session-jsonl',
  sessionsRoot,
  filesScanned: files.length,
  sessionsCounted: totals.sessions,
  totals,
  models,
};

console.log(JSON.stringify(out, null, 2));
NODE
}

historical_usage_to_tsv() {
  local pricing_path="${1:-}"
  node -e '
const fs = require("fs");
const pricingPath = process.argv[1] || "";
const raw = fs.readFileSync(0, "utf8");
const data = JSON.parse(raw);
const DEFAULT_PRICING_PER_M = {
  "gpt-5.4": { input: 2.5, cached: 0.25, output: 15 },
  "gpt-5.3-codex": { input: 1.75, cached: 0.175, output: 14 },
};

function normalizePricing(rawPricing) {
  if (!rawPricing || typeof rawPricing !== "object") return {};
  const src = (rawPricing.models && typeof rawPricing.models === "object") ? rawPricing.models : rawPricing;
  const out = {};
  for (const [model, v] of Object.entries(src)) {
    if (!v || typeof v !== "object") continue;
    const input = Number(v.input);
    const cached = Number(v.cached);
    const output = Number(v.output);
    const merged = {};
    if (Number.isFinite(input)) merged.input = input;
    if (Number.isFinite(cached)) merged.cached = cached;
    if (Number.isFinite(output)) merged.output = output;
    if (Object.keys(merged).length > 0) out[model] = merged;
  }
  return out;
}

let filePricing = {};
if (pricingPath && fs.existsSync(pricingPath)) {
  try {
    filePricing = normalizePricing(JSON.parse(fs.readFileSync(pricingPath, "utf8")));
  } catch {
    filePricing = {};
  }
}

const PRICING_PER_M = { ...DEFAULT_PRICING_PER_M };
for (const [model, v] of Object.entries(filePricing)) {
  PRICING_PER_M[model] = { ...(PRICING_PER_M[model] || {}), ...v };
}

function toM(n) {
  const m = Number(n || 0) / 1_000_000;
  const oneDecimalTrunc = Math.trunc(m * 10) / 10;
  return `${oneDecimalTrunc.toFixed(1)}M`;
}

function toCost(n) {
  const v = Number(n || 0);
  if (!Number.isFinite(v)) return "n/a";
  return `$${v.toFixed(2)}`;
}

const rows = [];
const totals = data?.totals || {};
const models = data?.models || [];
const totalSessionsDisplay = models.reduce((acc, m) => acc + Number(m?.sessions || 0), 0);

let totalCostInput = 0;
let totalCostCached = 0;
let totalCostOutput = 0;
for (const m of models) {
  const pricing = PRICING_PER_M[m.model || ""] || {};
  const inputTokens = Number(m.input || 0);
  const cachedTokens = Number(m.cached || 0);
  const nonCachedInputTokens = Math.max(0, inputTokens - cachedTokens);
  const costInput = Number.isFinite(pricing.input) ? (nonCachedInputTokens / 1_000_000) * pricing.input : NaN;
  const costCached = Number.isFinite(pricing.cached) ? (Number(m.cached || 0) / 1_000_000) * pricing.cached : NaN;
  const costOutput = Number.isFinite(pricing.output) ? (Number(m.outputWithReasoning || 0) / 1_000_000) * pricing.output : NaN;
  const costTotal = (Number.isFinite(costInput) && Number.isFinite(costCached) && Number.isFinite(costOutput))
    ? (costInput + costCached + costOutput)
    : NaN;

  if (Number.isFinite(costInput)) totalCostInput += costInput;
  if (Number.isFinite(costCached)) totalCostCached += costCached;
  if (Number.isFinite(costOutput)) totalCostOutput += costOutput;

  rows.push([
    m.model || "unknown",
    String(m.sessions || 0),
    toM(m.input),
    toM(m.outputWithReasoning),
    toM(m.cached),
    toCost(costInput),
    toCost(costOutput),
    toCost(costCached),
    toCost(costTotal),
  ]);
}

const totalCostInOut = totalCostInput + totalCostOutput;
const totalCostAll = totalCostInput + totalCostCached + totalCostOutput;
rows.push([
  "TOTAL",
  String(totalSessionsDisplay || totals.sessions || 0),
  toM(totals.input),
  toM(totals.outputWithReasoning),
  toM(totals.cached),
  toCost(totalCostInput),
  toCost(totalCostOutput),
  toCost(totalCostCached),
  toCost(totalCostAll),
  toCost(totalCostInOut),
]);

for (const r of rows) {
  process.stdout.write(r.join("\t") + "\n");
}
 ' "$pricing_path"
}

